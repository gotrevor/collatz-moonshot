import Mathlib

/-!
# A counter-machine engine with slopes in `2^ℤ 3^ℤ` (Lemma P, research §55-§57)

A 2-counter machine runs inside the integers using only multiplications by `2^i 3^j`.  Write a
nonzero `n` prime to `5` as `n = 2^a 3^b m` with `m` prime to `6`.  The **phase** of `n` is the
discrete logarithm of `n mod 25` to base `3` (a primitive root mod `25`), in `[0, 20)`; it stores
the machine state.  On the **engine zone** `b ≥ phase`, the counters are `C₁ = ⌊a/20⌋` and
`C₂ = ⌊(b − phase)/20⌋`; the rest, `(a mod 20, (b − phase) mod 20, m)`, is **junk**.

* `phase_scale`, `C1_scale`, `C2_scale`, `junk_scale`: the linear piece
  `n ↦ n · 2^{20δ₁} · 3^{20δ₂ + s' − s}` moves the state to `s'` and the counters by `(δ₁, δ₂)`,
  and leaves the junk alone (`scale_spec`, `inEngine_scale`).
* `one_le_C1_iff`, `one_le_C2_iff`: the zero tests are residue conditions, `2^20 ∣ n` and
  `3^{20 + phase} ∣ n`; the second threshold depends on the state.
* `eq_of_decode_eq`, `exists_decode`: an engine point is determined by its state, counters and
  junk, and every state and counter pair occurs with every junk value that occurs at all.  So the
  engine is conjugate to the machine times the identity on the junk.

This is the arithmetic heart of Theorem C: orbit counting for RCWA permutations of `ℤ` with all
slopes in `2^ℤ 3^ℤ` (the group generated by the slopes `3/2, 3/4` of Collatz's permutation) is
`Π⁰₂`-hard.
-/

namespace CollatzMoonshot.RcwaEngine

/-- Discrete log to base `3` in `ZMod 25`: the least `k < 20` with `3^k = x` (`0` if none). -/
def dlog3 (x : ZMod 25) : ℕ :=
  ((List.range 20).find? fun k => (3 : ZMod 25) ^ k = x).getD 0

/-- The phase (machine state) of `n`: the discrete log of `n mod 25`. -/
def phase (n : ℤ) : ℕ :=
  dlog3 (n : ZMod 25)

/-- `v₂(n)`. -/
def v2 (n : ℤ) : ℕ :=
  padicValInt 2 n

/-- `v₃(n)`. -/
def v3 (n : ℤ) : ℕ :=
  padicValInt 3 n

/-- The engine zone: `n ≠ 0`, `5 ∤ n`, and `v₃(n) ≥ phase n`. -/
def InEngine (n : ℤ) : Prop :=
  n ≠ 0 ∧ ¬ (5 : ℤ) ∣ n ∧ phase n ≤ v3 n

/-- The first counter `⌊v₂(n)/20⌋`. -/
def C1 (n : ℤ) : ℕ :=
  v2 n / 20

/-- The second counter `⌊(v₃(n) − phase n)/20⌋`. -/
def C2 (n : ℤ) : ℕ :=
  (v3 n - phase n) / 20

/-- The junk `(v₂ mod 20, (v₃ − phase) mod 20, the part of n prime to 6)`. -/
def junk (n : ℤ) : ℕ × ℕ × ℤ :=
  (v2 n % 20, (v3 n - phase n) % 20, n / (2 ^ v2 n * 3 ^ v3 n))

/-- Multiply by `2^A 3^B` for integer exponents `A, B` (exact when the denominators divide). -/
def scale (n A B : ℤ) : ℤ :=
  n * 2 ^ A.toNat * 3 ^ B.toNat / (2 ^ (-A).toNat * 3 ^ (-B).toNat)

/-- **Open.**  On the engine, `3^phase ≡ n (mod 25)` and `phase < 20`. -/
theorem phase_spec {n : ℤ} (hn : InEngine n) :
    phase n < 20 ∧ (3 : ZMod 25) ^ phase n = (n : ZMod 25) := by
  sorry

/-- **Open.**  The first zero test is `2^20 ∣ n`. -/
theorem one_le_C1_iff {n : ℤ} (hn : InEngine n) : 1 ≤ C1 n ↔ (2 : ℤ) ^ 20 ∣ n := by
  sorry

/-- **Open.**  The second zero test is `3^(20 + phase n) ∣ n`. -/
theorem one_le_C2_iff {n : ℤ} (hn : InEngine n) :
    1 ≤ C2 n ↔ (3 : ℤ) ^ (20 + phase n) ∣ n := by
  sorry

section Step

variable {n : ℤ} (hn : InEngine n) {s' : ℕ} (hs' : s' < 20) {δ₁ δ₂ : ℤ}
  (h₁ : 0 ≤ (C1 n : ℤ) + δ₁) (h₂ : 0 ≤ (C2 n : ℤ) + δ₂)
include hn hs' h₁ h₂

/-- **Open.**  The piece is exact: `scale` really multiplies by `2^{20δ₁} 3^{20δ₂ + s' − s}`. -/
theorem scale_spec :
    scale n (20 * δ₁) (20 * δ₂ + s' - phase n) * 2 ^ (-(20 * δ₁)).toNat *
        3 ^ (-(20 * δ₂ + s' - phase n)).toNat =
      n * 2 ^ (20 * δ₁).toNat * 3 ^ (20 * δ₂ + s' - phase n).toNat := by
  sorry

/-- **Open.**  The piece maps the engine into the engine. -/
theorem inEngine_scale : InEngine (scale n (20 * δ₁) (20 * δ₂ + s' - phase n)) := by
  sorry

/-- **Open.**  The piece moves the state to `s'`. -/
theorem phase_scale : phase (scale n (20 * δ₁) (20 * δ₂ + s' - phase n)) = s' := by
  sorry

/-- **Open.**  The piece adds `δ₁` to the first counter. -/
theorem C1_scale : (C1 (scale n (20 * δ₁) (20 * δ₂ + s' - phase n)) : ℤ) = C1 n + δ₁ := by
  sorry

/-- **Open.**  The piece adds `δ₂` to the second counter. -/
theorem C2_scale : (C2 (scale n (20 * δ₁) (20 * δ₂ + s' - phase n)) : ℤ) = C2 n + δ₂ := by
  sorry

/-- **Open.**  The piece leaves the junk unchanged. -/
theorem junk_scale : junk (scale n (20 * δ₁) (20 * δ₂ + s' - phase n)) = junk n := by
  sorry

end Step

/-- **Open.**  An engine point is determined by its state, counters and junk. -/
theorem eq_of_decode_eq {n n' : ℤ} (hn : InEngine n) (hn' : InEngine n')
    (hp : phase n = phase n') (h1 : C1 n = C1 n') (h2 : C2 n = C2 n') (hj : junk n = junk n') :
    n = n' := by
  sorry

/-- **Open.**  The junk is independent of the configuration: every state and counter pair occurs
with the junk of any engine point. -/
theorem exists_decode {n₀ : ℤ} (h₀ : InEngine n₀) {s : ℕ} (hs : s < 20) (c₁ c₂ : ℕ) :
    ∃ n, InEngine n ∧ phase n = s ∧ C1 n = c₁ ∧ C2 n = c₂ ∧ junk n = junk n₀ := by
  sorry

end CollatzMoonshot.RcwaEngine
