/-- The immediate sibling-floor obstruction does not fire on the exported
beta=1/10, width=31/100, k=6 witness, on any open endpoint-partition cell. -/
theorem delay_witness_no_sibling_floor_conflicts :
    witnessHasSiblingConflict 6 delayWitnessFloorPieces = false := by native_decide

/-- Two intervals of word zero in the exported witness.  The third is unnecessary. -/
def witnessWordZeroCore : Set ℝ :=
  Set.Icc 0 (473 / 1024) ∪ Set.Icc (2299 / 4096) (2839 / 4096)

/-- No fixed residue and child-base assignment works for the whole word-zero set.
This excludes word-only relabelings; position-dependent encodings remain open. -/
theorem witness_word_zero_no_fixed_base (h A B : ℕ) (hh : 2 ≤ h) :
    ¬ FixedChildBaseRealization h A B witnessWordZeroCore := by
  apply two_starts_preclude_fixed_child_base h A B hh
  · norm_num [witnessWordZeroCore, Set.mem_union, Set.mem_Icc]
  · norm_num [witnessWordZeroCore, Set.mem_union, Set.mem_Icc]

