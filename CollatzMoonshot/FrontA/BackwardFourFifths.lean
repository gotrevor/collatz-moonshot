def fourFifthsPotential (i : Fin 5) (r : ℕ) : ℕ :=
  (fourFifthsWeights[
    i.1 * 4374 + fourFifthsUnitIndex (r % 6561)]?).getD 0

/-- The elementary exact comparisons behind the rational 4/5 edge underweight. -/
theorem fourFifthsRationalUnderestimate :
    (75257 / 31250 : ℚ) ^ 5 < 81 ∧ 16 * (574349 / 1000000 : ℚ) ^ 5 < 1 := by
  norm_num

/-! ## The shared next ternary digit (source mod 19683, child mod 6561) -/

/-- The child residue modulo `6561` determined by the source modulo `19683`,
including the fixed carry digit produced by the division `(2^j r - 1) / 3`. -/
def fourFifthsChildResidue (r j : ℕ) : ℕ :=
  ((2 ^ j * (r % 19683) - 1) / 3) % 6561

/-- An actual odd inverse block has the child residue predicted by
`fourFifthsChildResidue`. -/
theorem oddBlockChild_mod_6561 {x y j : ℕ}
    (h : 3 * y + 1 = 2 ^ j * x) :
    y % 6561 = fourFifthsChildResidue x j := by
  unfold fourFifthsChildResidue
  have hx : x % 19683 + 19683 * (x / 19683) = x := Nat.mod_add_div x 19683
  have hp : 0 < 2 ^ j := pow_pos (by omega) _
  have heq :
      3 * y + 1 =
        2 ^ j * (x % 19683) + 19683 * (2 ^ j * (x / 19683)) := by
    calc
      3 * y + 1 = 2 ^ j * x := h
      _ = 2 ^ j * (x % 19683 + 19683 * (x / 19683)) :=
        congrArg (fun z => 2 ^ j * z) hx.symm
      _ = 2 ^ j * (x % 19683) + 19683 * (2 ^ j * (x / 19683)) := by ring
  have hr : 0 < x % 19683 := by
    by_contra hz
    have hz' : x % 19683 = 0 := Nat.eq_zero_of_not_pos hz
    rw [hz', mul_zero, zero_add] at heq
    omega
  have hpr : 0 < 2 ^ j * (x % 19683) := Nat.mul_pos hp hr
  let z := 2 ^ j * (x / 19683)
  have hzle : 6561 * z ≤ y := by dsimp [z]; omega
  have hnum : 2 ^ j * (x % 19683) - 1 = 3 * (y - 6561 * z) := by dsimp [z]; omega
  have ha : (2 ^ j * (x % 19683) - 1) / 3 = y - 6561 * z := by rw [hnum]; omega
  rw [ha]; omega

/-- The child residue seen from a state residue modulo `6561` together with one
shared next ternary digit `t` of the source. -/
def fourFifthsSharedLift (r j t : ℕ) : ℕ :=
  fourFifthsChildResidue (r % 6561 + 6561 * (t % 3)) j

/-- The single shared digit `t = x / 6561 % 3` really controls every actual
child: an odd block from `x` lands in the residue class it selects. -/
theorem oddBlockChild_sharedLift_6561 {x y j : ℕ}
    (h : 3 * y + 1 = 2 ^ j * x) :
    y % 6561 = fourFifthsSharedLift x j (x / 6561 % 3) := by
  rw [oddBlockChild_mod_6561 h]
  unfold fourFifthsSharedLift fourFifthsChildResidue
  have h19683 : (x % 6561 + 6561 * (x / 6561 % 3 % 3)) % 19683 = x % 19683 := by
    omega
  rw [h19683]

theorem fourFifthsSharedLift_mod_left (x j t : ℕ) :
    fourFifthsSharedLift (x % 6561) j t = fourFifthsSharedLift x j t := by
  unfold fourFifthsSharedLift
  rw [Nat.mod_mod_of_dvd x dvd_rfl]

theorem fourFifthsSharedLift_mod_right (x j t : ℕ) :
    fourFifthsSharedLift x j (t % 3) = fourFifthsSharedLift x j t := by
  unfold fourFifthsSharedLift
  rw [Nat.mod_mod_of_dvd t dvd_rfl]

/-! ## Potential helpers -/

/-- The state potential depends only on the residue modulo `6561`. -/
theorem fourFifthsPotential_mod (i : Fin 5) (x : ℕ) :
    fourFifthsPotential i (x % 6561) = fourFifthsPotential i x := by
  unfold fourFifthsPotential
  rw [Nat.mod_mod_of_dvd x dvd_rfl]

/-- Every reusable residue has strictly positive potential at every floor. -/
theorem fourFifthsPotential_pos_of_unit :
    ∀ i : Fin 5, ∀ r : Fin 6561, r.1 % 3 ≠ 0 →
      0 < fourFifthsPotential i r.1 := by
  native_decide

theorem sevenCostsAt_mod_6561 (x : ℕ) :
    sevenCostsAt (x % 6561) = sevenCostsAt x := by
  unfold sevenCostsAt
  rw [Nat.mod_mod_of_dvd x (by norm_num : 9 ∣ 6561)]

theorem fourFifthsHasShrink_mod_6561 (i : Fin 5) (x : ℕ) :
    threeQuartersHasShrink i (x % 6561) = threeQuartersHasShrink i x := by
  unfold threeQuartersHasShrink
  rw [Nat.mod_mod_of_dvd x (by norm_num : 9 ∣ 6561)]

/-! ## The native-checked integer certificate -/

/-- One integer-scaled growing edge: the true edge weight
`(75257/31250)·(574349/1000000)^j` cleared to scale `31250 · 1000000^23`. -/
def fourFifthsNatEdge (i : Fin 5) (r t j : ℕ) : ℕ :=
  574349 ^ j * 1000000 ^ (23 - j) *
    fourFifthsPotential (nextThreeQuartersState i j)
      (fourFifthsSharedLift r j t)

/-- The integer-scaled one-generation transfer image at one source lift. -/
def fourFifthsNatImage (i : Fin 5) (r t : ℕ) : ℕ :=
  75257 * (fourFifthsNatEdge i r t (sevenCostsAt r 0) +
    fourFifthsNatEdge i r t (sevenCostsAt r 1) +
    fourFifthsNatEdge i r t (sevenCostsAt r 2) +
    fourFifthsNatEdge i r t (sevenCostsAt r 3) +
    fourFifthsNatEdge i r t (sevenCostsAt r 4) +
    fourFifthsNatEdge i r t (sevenCostsAt r 5) +
    fourFifthsNatEdge i r t (sevenCostsAt r 6) +
    if threeQuartersHasShrink i r then
      574349 * 1000000 ^ 22 *
        fourFifthsPotential (shrinkThreeQuartersState i)
          (fourFifthsSharedLift r 1 t)
    else 0)

/-- All `4374 × 5 × 3 = 65610` source-state/lift inequalities of the frozen
certificate, in integer form at scale `31250 · 1000000^23`. -/
theorem fourFifthsNatCertificate :
    ∀ i : Fin 5, ∀ t : Fin 3, ∀ r : Fin 6561, r.1 % 3 ≠ 0 →
      31250 * 1000000 ^ 23 * fourFifthsPotential i r.1 <
        fourFifthsNatImage i r.1 t.1 := by
  native_decide

/-! ## The rational certificate -/

/-- The rational one-generation transfer image at one source lift, with the
exact edge underweight `(75257/31250) · (574349/1000000)^j`. -/
def fourFifthsImage (i : Fin 5) (r t : ℕ) : ℚ :=
  (75257 / 31250 : ℚ) *
    (∑ k : Fin 7, (574349 / 1000000 : ℚ) ^ sevenCostsAt r k *
        fourFifthsPotential (nextThreeQuartersState i (sevenCostsAt r k))
          (fourFifthsSharedLift r (sevenCostsAt r k) t) +
      if threeQuartersHasShrink i r then
        (574349 / 1000000 : ℚ) *
          fourFifthsPotential (shrinkThreeQuartersState i)
            (fourFifthsSharedLift r 1 t)
      else 0)

theorem fourFifthsImage_mod (i : Fin 5) (x t : ℕ) :
    fourFifthsImage i (x % 6561) (t % 3) = fourFifthsImage i x t := by
  unfold fourFifthsImage
  simp only [sevenCostsAt_mod_6561, fourFifthsSharedLift_mod_left,
    fourFifthsSharedLift_mod_right, fourFifthsHasShrink_mod_6561]

private theorem qpow_scale_4f {j : ℕ} (hj : j ≤ 23) :
    ((574349 : ℚ) / 1000000) ^ j * 1000000 ^ 23 =
      574349 ^ j * 1000000 ^ (23 - j) := by
  have hsplit : (1000000 : ℚ) ^ 23 = 1000000 ^ j * 1000000 ^ (23 - j) := by
    rw [← pow_add]; congr 1; omega
  have hcancel : ((574349 : ℚ) / 1000000) ^ j * 1000000 ^ j = 574349 ^ j := by
    rw [div_pow]; field_simp
  rw [hsplit, ← mul_assoc, hcancel]

/-- The integer-scaled image is exactly `31250 · 1000000^23` times the rational
image. -/
theorem fourFifthsNatImage_eq (i : Fin 5) (r t : ℕ) :
    (fourFifthsNatImage i r t : ℚ) =
      31250 * 1000000 ^ 23 * fourFifthsImage i r t := by
  have h0 := qpow_scale_4f (sevenCostsAt_le_twentyThree r 0)
  have h1 := qpow_scale_4f (sevenCostsAt_le_twentyThree r 1)
  have h2 := qpow_scale_4f (sevenCostsAt_le_twentyThree r 2)
  have h3 := qpow_scale_4f (sevenCostsAt_le_twentyThree r 3)
  have h4 := qpow_scale_4f (sevenCostsAt_le_twentyThree r 4)
  have h5 := qpow_scale_4f (sevenCostsAt_le_twentyThree r 5)
  have h6 := qpow_scale_4f (sevenCostsAt_le_twentyThree r 6)
  unfold fourFifthsNatImage fourFifthsNatEdge fourFifthsImage
  rw [Fin.sum_univ_seven]
  by_cases hs : threeQuartersHasShrink i r = true <;>
    simp only [hs, if_true, Bool.false_eq_true, if_false] <;>
    push_cast <;>
    rw [← h0, ← h1, ← h2, ← h3, ← h4, ← h5, ← h6] <;>
    ring

/-- The rational certificate at an arbitrary reusable source and arbitrary
shared lift digit. -/
theorem fourFifthsPotentialCertificateAt (i : Fin 5) {x : ℕ} (h3 : ¬3 ∣ x)
    (t : ℕ) : (fourFifthsPotential i x : ℚ) < fourFifthsImage i x t := by
  have hr6561 : x % 6561 < 6561 := Nat.mod_lt x (by norm_num)
  have hru : (x % 6561) % 3 ≠ 0 := by
    rw [Nat.mod_mod_of_dvd x (by norm_num : 3 ∣ 6561)]
    exact fun h0 => h3 (Nat.dvd_of_mod_eq_zero h0)
  have hnat := fourFifthsNatCertificate i ⟨t % 3, Nat.mod_lt t (by norm_num)⟩
    ⟨x % 6561, hr6561⟩ hru
  have hq : (fourFifthsPotential i (x % 6561) : ℚ) <
      fourFifthsImage i (x % 6561) (t % 3) := by
    have hcast :
        ((31250 * 1000000 ^ 23 * fourFifthsPotential i (x % 6561) : ℕ) : ℚ) <
        (fourFifthsNatImage i (x % 6561) (t % 3) : ℚ) := by
      exact_mod_cast hnat
    rw [fourFifthsNatImage_eq] at hcast
    push_cast at hcast
    have hpos : (0 : ℚ) < 31250 * 1000000 ^ 23 := by norm_num
    exact lt_of_mul_lt_mul_left (by linarith) (le_of_lt hpos)
  rw [fourFifthsPotential_mod, fourFifthsImage_mod] at hq
  exact hq

/-- Pinned correlated exponent-4/5 local expansion target. -/
theorem exists_fourFifthsExpansion {d x : ℕ} (i : Fin 5) (hd : 2 ≤ d)
    (hx : 2 ≤ x) (h3 : ¬3 ∣ x)
    (hstate : InThreeQuartersHeightState d i x) :
    ∃ (ys : Fin 7 → ℕ) (z : ℕ), Function.Injective ys ∧
      (∀ k, GrowingUnitOddBlockChild x (ys k) (sevenCostsAt x k) ∧
        InThreeQuartersHeightState d
          (nextThreeQuartersState i (sevenCostsAt x k)) (ys k) ∧
        3 * ys k < 2 ^ 23 * x) ∧
      (threeQuartersHasShrink i x = true →
        UnitOddBlockChildAtOne x z ∧
        InThreeQuartersHeightState d (shrinkThreeQuartersState i) z ∧
        ∀ k, z ≠ ys k) ∧
      (fourFifthsPotential i x : ℚ) <
        (75257 / 31250 : ℚ) *
          (∑ k : Fin 7, (574349 / 1000000 : ℚ) ^ sevenCostsAt x k *
              fourFifthsPotential
                (nextThreeQuartersState i (sevenCostsAt x k)) (ys k) +
            if threeQuartersHasShrink i x then
              (574349 / 1000000 : ℚ) *
                fourFifthsPotential (shrinkThreeQuartersState i) z
            else 0) := by
  obtain ⟨ys, hys, hch⟩ := exactSevenCostTransferAt hx h3
  have hcert := fourFifthsPotentialCertificateAt i h3 (x / 6561 % 3)
  have hgrow : ∀ k, GrowingUnitOddBlockChild x (ys k) (sevenCostsAt x k) ∧
      InThreeQuartersHeightState d
        (nextThreeQuartersState i (sevenCostsAt x k)) (ys k) ∧
      3 * ys k < 2 ^ 23 * x := by
    intro k
    refine ⟨hch k,
      threeQuartersHeightStep_growing hd (hch k).1 hstate (hch k).2.2.2.2, ?_⟩
    have hc := sevenCostsAt_le_twentyThree x k
    have hple : (2 : ℕ) ^ sevenCostsAt x k ≤ 2 ^ 23 :=
      Nat.pow_le_pow_right (by norm_num) hc
    have hmul : 2 ^ sevenCostsAt x k * x ≤ 2 ^ 23 * x :=
      Nat.mul_le_mul_right x hple
    have hb := (hch k).2.2.2.2
    omega
  have hpotEq : ∀ k : Fin 7,
      fourFifthsPotential (nextThreeQuartersState i (sevenCostsAt x k))
        (fourFifthsSharedLift x (sevenCostsAt x k) (x / 6561 % 3)) =
      fourFifthsPotential (nextThreeQuartersState i (sevenCostsAt x k))
        (ys k) := by
    intro k
    rw [← oddBlockChild_sharedLift_6561 (hch k).2.2.2.2, fourFifthsPotential_mod]
  by_cases hs : threeQuartersHasShrink i x = true
  · have hrem : x % 9 = 2 ∨ x % 9 = 8 := by
      unfold threeQuartersHasShrink at hs
      simp only [Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq,
        decide_eq_true_eq] at hs
      exact hs.2
    have hi1 : 1 ≤ i.1 := by
      unfold threeQuartersHasShrink at hs
      simp only [Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq,
        decide_eq_true_eq] at hs
      exact hs.1
    obtain ⟨z, hz⟩ := exists_unitOddBlockChildAtOne hrem
    have hzblock : 3 * z + 1 = 2 ^ 1 * x := by
      have := hz.2.2.2; norm_num; omega
    have hz6561 :
        fourFifthsPotential (shrinkThreeQuartersState i)
          (fourFifthsSharedLift x 1 (x / 6561 % 3)) =
        fourFifthsPotential (shrinkThreeQuartersState i) z := by
      rw [← oddBlockChild_sharedLift_6561 hzblock, fourFifthsPotential_mod]
    refine ⟨ys, z, hys, hgrow, fun _ =>
      ⟨hz, threeQuartersHeightStep_shrinking hd hi1 hstate hz.2.2.2,
        fun k hzy => ?_⟩, ?_⟩
    · have hzlt := hz.2.2.1
      have hylt := (hch k).2.2.2.1
      omega
    · have himg : fourFifthsImage i x (x / 6561 % 3) =
          (75257 / 31250 : ℚ) *
            (∑ k : Fin 7, (574349 / 1000000 : ℚ) ^ sevenCostsAt x k *
                fourFifthsPotential
                  (nextThreeQuartersState i (sevenCostsAt x k)) (ys k) +
              if threeQuartersHasShrink i x then
                (574349 / 1000000 : ℚ) *
                  fourFifthsPotential (shrinkThreeQuartersState i) z
              else 0) := by
        unfold fourFifthsImage
        rw [Finset.sum_congr rfl fun k _ => by rw [hpotEq k]]
        simp only [hs, if_true, hz6561]
      exact himg ▸ hcert
  · refine ⟨ys, 0, hys, hgrow, fun hcontra => absurd hcontra hs, ?_⟩
    have himg : fourFifthsImage i x (x / 6561 % 3) =
        (75257 / 31250 : ℚ) *
          (∑ k : Fin 7, (574349 / 1000000 : ℚ) ^ sevenCostsAt x k *
              fourFifthsPotential
                (nextThreeQuartersState i (sevenCostsAt x k)) (ys k) +
            if threeQuartersHasShrink i x then
              (574349 / 1000000 : ℚ) *
                fourFifthsPotential (shrinkThreeQuartersState i) 0
            else 0) := by
      unfold fourFifthsImage
      rw [Finset.sum_congr rfl fun k _ => by rw [hpotEq k]]
      rw [Bool.not_eq_true] at hs
      simp only [hs, Bool.false_eq_true, if_false]
    exact himg ▸ hcert

end CollatzMoonshot.FrontA
