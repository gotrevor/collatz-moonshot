import Mathlib
import CollatzMoonshot.RcwaTotalityGlue

/-!
# Totality family, layer 2: a computable compile of the glued machines

For a *fixed* machine `B₀` (in practice `histWrap` of the fixed restart machine) and gluing data
`hole`, `back`, `i`, the machines `R L := godel (glue B₀ hole back i L) p N` vary with `L` only
through `L` copies of one small block.  `exists_computable_compile` turns this into a computable
family `L ↦ G L` of `Machine`s with `G L` valid and `SourcesHalt (G L) ↔ Mortal (R L)`.  The
obstacle it removes: `exists_valid_machine` numbers states by `Fintype.equivFin` over types that
vary with the input, so `e ↦ M_e` is not visibly computable.

1. **`godel` is local** (`godel_local`, `godel_single_mapQ`, `godel_mapQ`, `godel_mono`): apart
   from the guard rules (one per state), every rule of `godel B` is generated by a single rule of
   `B`, and relabelling `B` relabels the rules it generates.  So the rules of `R L` are the images
   of two *fixed* finite lists: `fixList` (the rules of `godel B₀`, mapped by `inl`) and
   `unitList` (the rules of `godel` of the one-rule machine `unitRule i = [some (), +i, none]`),
   mapped once by `plugMap` (the link `hole → first`) and once per chain state `k` by `linkMap k`
   (`mem_rsGlue`).
2. **Numbering.**  `glueNum L` numbers `GState (QB ⊕ Fin L) N` as the fixed `fixNum` on the
   `inl` part, then block `k` of size `T = card (GState Unit N)` for chain state `k`.  Under it the
   typed list `rsGlue L` becomes the explicit `ℕ`-quadruple list `explicitR L` (`rsGlue_num`):
   constants plus `L` relocated copies of the constant `unitR` (`reloc`, `plugReloc`).
3. **Doubling on `ℕ`.**  `doubleN R' S` is `RcwaHalting.double` on states `0, …, S − 1`, with layer
   `true` at `2 s + 1` and layer `false` at `2 s`.  With the layer numbering `layerEquiv num`,
   `double rs` and `doubleN (rs.map num)` are the same machine up to the order of rules
   (`doubleN_valid_iff`, via `machine_congr`).
4. **Computability** of `doubleN` and `explicitR` (`computable_doubleN`, `computable_explicitR`),
   with `Primcodable (Quad ℕ (Fin 2))` through `ℕ × Op (Fin 2) × ℕ`.
-/

namespace CollatzMoonshot.RcwaHalting

/-! ## 0. Gödel states: base and tag -/

section GStateMap

variable {Q Q' : Type*} {N : ℕ}

/-- Relabel the base state of a Gödel-compile state. -/
def GState.map (f : Q → Q') : GState Q N → GState Q' N
  | .ent q => .ent (f q)
  | .grd q => .grd (f q)
  | .a₁ q => .a₁ (f q)
  | .a₂ q => .a₂ (f q)
  | .a₃ q => .a₃ (f q)
  | .a₄ q => .a₄ (f q)
  | .b₁ q => .b₁ (f q)
  | .b₂ q => .b₂ (f q)
  | .b₃ q => .b₃ (f q)
  | .mul q j => .mul (f q) j
  | .dv q j => .dv (f q) j
  | .w₁ q j => .w₁ (f q) j
  | .w₂ q j => .w₂ (f q) j
  | .r₁ s j => .r₁ (f s) j
  | .r₂ s j => .r₂ (f s) j

/-- The base state of a Gödel-compile state. -/
def GState.base : GState Q N → Q
  | .ent q | .grd q | .a₁ q | .a₂ q | .a₃ q | .a₄ q | .b₁ q | .b₂ q | .b₃ q => q
  | .mul q _ | .dv q _ | .w₁ q _ | .w₂ q _ | .r₁ q _ | .r₂ q _ => q

/-- The shape of a Gödel-compile state, forgetting the base. -/
def GState.tag (g : GState Q N) : GState Unit N :=
  g.map fun _ => ()

/-- A Gödel-compile state is its base and its tag. -/
def GState.baseTagEquiv : GState Q N ≃ Q × GState Unit N where
  toFun g := (g.base, g.tag)
  invFun x := x.2.map fun _ => x.1
  left_inv g := by cases g <;> rfl
  right_inv x := by obtain ⟨q, t⟩ := x; cases t <;> rfl

end GStateMap

end CollatzMoonshot.RcwaHalting

namespace CollatzMoonshot.RcwaTotality

open CollatzMoonshot.CounterMachine CollatzMoonshot.RcwaHalting
open CollatzMoonshot.RcwaSameOrbit (Rule Machine step Deterministic)
open CollatzMoonshot.RcwaOrbitCount (Mortal SourcesHalt)

/-! ## 1. `godel` is local -/

section Local

variable {Q Q' ι : Type*} {N : ℕ} {p : ι → ℕ}

/-- The guard rule at `q`, present in every `godel B`. -/
def guardRule (q : Q) : Quad (GState Q N) (Fin 2) :=
  ⟨.ent q, .test 0 true, .grd q⟩

/-- **Transport.**  If every rule of `B` relabels into `B'`, every rule of `godel B` relabels
into `godel B'`. -/
theorem godel_map_gen (f : Q → Q') {B : CM Q ι} {B' : CM Q' ι}
    (hB : ∀ ρ ∈ B, ρ.mapQ f ∈ B') {r : Quad (GState Q N) (Fin 2)}
    (hr : r ∈ godel B p N) : r.mapQ (GState.map f) ∈ godel B' p N := by
  have hmv : ∀ {q i q'}, MoveRule B q i q' → MoveRule B' (f q) i (f q') :=
    fun h => h.imp (hB _) (hB _)
  change GRule B' p N _
  cases hr <;> simp only [Quad.mapQ, GState.map] <;>
    first
    | (apply GRule.exitP <;> first | exact hB _ (by assumption) | assumption)
    | (apply GRule.exitZ <;> first | exact hB _ (by assumption) | assumption)
    | (constructor <;> first | exact hB _ (by assumption) | exact hmv (by assumption) |
        assumption)

theorem GState.map_id' (g : GState Q N) : g.map id = g := by cases g <;> rfl

/-- `godel` is monotone in the machine. -/
theorem godel_mono {B B' : CM Q ι} (h : B ⊆ B') {r : Quad (GState Q N) (Fin 2)}
    (hr : r ∈ godel B p N) : r ∈ godel B' p N := by
  have := godel_map_gen id (fun ρ hρ => h hρ) hr
  simpa [Quad.mapQ, GState.map_id'] using this

/-- Relabelling the machine relabels the compiled rules. -/
theorem godel_mapQ (f : Q → Q') {B : CM Q ι} {r : Quad (GState Q N) (Fin 2)}
    (hr : r ∈ godel B p N) : r.mapQ (GState.map f) ∈ godel (B.mapQ f) p N :=
  godel_map_gen f (fun ρ hρ => show ∃ ρ' ∈ B, ρ.mapQ f = ρ'.mapQ f from ⟨ρ, hρ, rfl⟩)
    hr

/-- **Locality.**  A rule of `godel B` is a guard or is generated by a single rule of `B`. -/
theorem godel_local {B : CM Q ι} {r : Quad (GState Q N) (Fin 2)} (hr : r ∈ godel B p N) :
    (∃ q, r = guardRule q) ∨ ∃ β ∈ B, r ∈ godel ({β} : CM Q ι) p N := by
  cases hr
  case guard q => exact Or.inl ⟨q, rfl⟩
  all_goals right
  all_goals first
    | (rcases (‹MoveRule B _ _ _› : MoveRule B _ _ _) with h | h <;> refine ⟨_, h, ?_⟩ <;>
        change GRule _ p N _ <;>
        (constructor <;> first | exact rfl | exact Or.inl rfl | exact Or.inr rfl | assumption))
    | (refine ⟨_, (by assumption : _ ∈ B), ?_⟩
       change GRule _ p N _
       first
       | (apply GRule.exitP <;> first | exact rfl | assumption)
       | (apply GRule.exitZ <;> first | exact rfl | assumption)
       | (constructor <;> first | exact rfl | assumption))

/-- The tags whose base is the target of the generating rule (in a non-guard rule). -/
def roleD : GState Unit N → Bool
  | .ent _ => true
  | .r₁ _ _ => true
  | .r₂ _ _ => true
  | _ => false

/-- Put the generating rule's source `s` or target `d` back as the base, by the tag. -/
def pullG (s d : Q) (g : GState Q' N) : GState Q N :=
  g.tag.map fun _ => if roleD g.tag then d else s

/-- The rules generated by one relabelled rule are the relabelled rules it generates (plus
guards). -/
theorem godel_single_mapQ (f : Q → Q') {β : Quad Q ι} {r : Quad (GState Q' N) (Fin 2)}
    (hr : r ∈ godel ({β.mapQ f} : CM Q' ι) p N) :
    (∃ q, r = guardRule q) ∨ ∃ r₀ ∈ godel ({β} : CM Q ι) p N, r = r₀.mapQ (GState.map f) := by
  obtain ⟨s, o, d⟩ := β
  suffices H : (∃ q, r = guardRule q) ∨
      ((⟨pullG s d r.src, r.op, pullG s d r.dst⟩ : Quad (GState Q N) (Fin 2)) ∈
        godel ({⟨s, o, d⟩} : CM Q ι) p N ∧
        r = (⟨pullG s d r.src, r.op, pullG s d r.dst⟩ : Quad (GState Q N) (Fin 2)).mapQ
          (GState.map f)) by
    rcases H with H | H
    · exact Or.inl H
    · exact Or.inr ⟨_, H.1, H.2⟩
  cases hr
  case guard q => exact Or.inl ⟨q, rfl⟩
  all_goals right
  all_goals
    first
    | (rcases (‹MoveRule _ _ _ _› : MoveRule _ _ _ _) with h | h <;>
        simp only [Set.mem_singleton_iff, Quad.mapQ, Quad.mk.injEq] at h <;>
        obtain ⟨rfl, rfl, rfl⟩ := h)
    | (have h := ‹_ ∈ ({Quad.mapQ f ⟨s, o, d⟩} : CM Q' ι)›
       simp only [Set.mem_singleton_iff, Quad.mapQ, Quad.mk.injEq] at h
       obtain ⟨rfl, rfl, rfl⟩ := h)
  all_goals
    refine ⟨?_, rfl⟩
    change GRule _ p N _
    simp only [pullG, GState.tag, GState.map, roleD]
    first
    | (apply GRule.exitP <;> first | exact rfl | assumption)
    | (apply GRule.exitZ <;> first | exact rfl | assumption)
    | (constructor <;> first | exact rfl | exact Or.inl rfl | exact Or.inr rfl | assumption)

end Local

/-! ## 2. Doubling on `ℕ`-numbered states -/

section DoubleN

/-- `RcwaHalting.double` on states `0, …, S − 1`: state `s` is `2 s + 1` in layer `true` and
`2 s` in layer `false`. -/
def doubleN (rs : List (Quad ℕ (Fin 2))) (S : ℕ) : Machine where
  K := S * 2
  rules := rs.map (toRule fun s => 2 * s + 1) ++ rs.map (fun ρ => toRule (fun s => 2 * s) ρ.inv) ++
    (List.range S).flatMap (turnRules rs (fun s => 2 * s + 1) (fun s => 2 * s))
  pair := (List.range (S * 2)).map fun n => if n % 2 = 0 then n + 1 else n - 1

/-- The layer numbering of a state numbering: `(q, b) ↦ 2 · num q + (if b then 1 else 0)`. -/
def layerEquiv {Q : Type*} {S : ℕ} (num : Q ≃ Fin S) : Q × Bool ≃ Fin (S * 2) :=
  (Equiv.prodCongr num finTwoEquiv.symm).trans finProdFinEquiv

/-- Rule lists with the same members fire alike when one of them is deterministic. -/
theorem step_congr {R R' : List Rule} (hmem : ∀ ρ, ρ ∈ R ↔ ρ ∈ R') (hdet : Deterministic R') :
    step R = step R' := by
  have hdet' : Deterministic R := fun ρ hρ ρ' hρ' =>
    hdet ρ ((hmem ρ).1 hρ) ρ' ((hmem ρ').1 hρ')
  funext c
  cases h : R.find? (fun ρ => decide (ρ.Fires c)) with
  | none =>
    have h1 : step R c = none := by simp [step, h]
    rw [h1, eq_comm]
    simp only [step, Option.map_eq_none_iff, List.find?_eq_none]
    rw [List.find?_eq_none] at h
    exact fun ρ hρ => h ρ ((hmem ρ).2 hρ)
  | some ρ₀ =>
    have hρ₀ := List.mem_of_find?_eq_some h
    have hf : ρ₀.Fires c := by simpa using List.find?_some h
    rw [RcwaSameOrbit.step_eq_of_fires hdet' hρ₀ hf,
      RcwaSameOrbit.step_eq_of_fires hdet ((hmem _).1 hρ₀) hf]

open RcwaSameOrbit (IsSink IsSource run NoBiInfinite EndToStart) in
/-- `Valid` transfers along machines with the same `K`, `pair`, members and step. -/
theorem valid_of_congr {M M' : Machine} (hK : M.K = M'.K) (hpair : M.pair = M'.pair)
    (hmem : ∀ ρ, ρ ∈ M.rules ↔ ρ ∈ M'.rules) (hstep : step M.rules = step M'.rules)
    (h : M'.Valid) : M.Valid := by
  have hpf : M.pairFn = M'.pairFn := by funext s; simp [Machine.pairFn, hpair]
  have hsink : IsSink M.rules = IsSink M'.rules := by funext c; simp [IsSink, hstep]
  have hsrc : IsSource M.rules = IsSource M'.rules := by funext c; simp [IsSource, hstep]
  have hrun : run M.rules = run M'.rules := by funext n c; simp [run, hstep]
  obtain ⟨⟨h1, h2, h3⟩, h4, h5, h6, h7⟩ := h
  refine ⟨⟨fun ρ hρ => hK ▸ h1 ρ ((hmem ρ).1 hρ), fun ρ hρ => hK ▸ h2 ρ ((hmem ρ).1 hρ),
    by rw [hpair, hK]; exact h3⟩,
    fun ρ hρ ρ' hρ' => h4 ρ ((hmem ρ).1 hρ) ρ' ((hmem ρ').1 hρ'), ?_, ?_, ?_⟩
  · rw [hsink, hsrc, hpf]; exact h5
  · unfold NoBiInfinite; rw [hstep]; exact h6
  · unfold EndToStart; rw [hsrc, hrun, hsink, hpf]; exact h7

/-- **Machines with the same members.**  Same `K`, same `pair`, the same rules up to order, one
of them deterministic: valid together, and all sources halt together. -/
theorem machine_congr {M M' : Machine} (hK : M.K = M'.K) (hpair : M.pair = M'.pair)
    (hmem : ∀ ρ, ρ ∈ M.rules ↔ ρ ∈ M'.rules) (hdet : Deterministic M'.rules) :
    (M.Valid ↔ M'.Valid) ∧ (SourcesHalt M ↔ SourcesHalt M') := by
  have hstep := step_congr hmem hdet
  refine ⟨⟨fun h => valid_of_congr hK.symm hpair.symm (fun ρ => (hmem ρ).symm) hstep.symm h,
    valid_of_congr hK hpair hmem hstep⟩, ?_⟩
  have hsink : RcwaSameOrbit.IsSink M.rules = RcwaSameOrbit.IsSink M'.rules := by
    funext c; simp [RcwaSameOrbit.IsSink, hstep]
  have hsrc : RcwaSameOrbit.IsSource M.rules = RcwaSameOrbit.IsSource M'.rules := by
    funext c; simp [RcwaSameOrbit.IsSource, hstep]
  have hrun : RcwaSameOrbit.run M.rules = RcwaSameOrbit.run M'.rules := by
    funext n c; simp [RcwaSameOrbit.run, hstep]
  unfold SourcesHalt RcwaSameOrbit.Halts
  rw [hsink, hsrc, hrun]

theorem layerEquiv_val {Q : Type*} {S : ℕ} (num : Q ≃ Fin S) (q : Q) (b : Bool) :
    (layerEquiv num (q, b)).val = 2 * (num q).val + if b then 1 else 0 := by
  cases b <;> simp [layerEquiv, finProdFinEquiv, finTwoEquiv]
  ring

theorem toRule_mapQ' {Q Q' : Type*} (n : Q' → ℕ) (f : Q → Q') (ρ : Quad Q (Fin 2)) :
    toRule n (ρ.mapQ f) = toRule (n ∘ f) ρ := by
  obtain ⟨s, o, d⟩ := ρ
  cases o <;> rfl

theorem Quad.inv_mapQ' {Q Q' ι : Type*} (f : Q → Q') (ρ : Quad Q ι) :
    (ρ.mapQ f).inv = ρ.inv.mapQ f := rfl

theorem turnRules_mapQ' {Q Q' : Type*} [DecidableEq Q] [DecidableEq Q'] {f : Q → Q'}
    (hf : Function.Injective f) (rs : List (Quad Q (Fin 2))) (nP nM : Q' → ℕ) (q : Q) :
    turnRules (rs.map (Quad.mapQ f)) nP nM (f q) = turnRules rs (nP ∘ f) (nM ∘ f) q := by
  simp only [turnRules, List.any_map, Function.comp_def, Quad.mapQ, hf.eq_iff]

/-- **The bridge.**  The doubling numbered by `layerEquiv num` is `doubleN` of the numbered rule
list, up to the order of rules. -/
theorem doubleN_valid_iff {Q : Type*} [DecidableEq Q] {S : ℕ} (num : Q ≃ Fin S)
    (rs : List (Quad Q (Fin 2))) (hdet : Deterministic (double rs (layerEquiv num)).rules) :
    ((doubleN (rs.map (Quad.mapQ fun q => (num q).val)) S).Valid ↔
        (double rs (layerEquiv num)).Valid) ∧
      (SourcesHalt (doubleN (rs.map (Quad.mapQ fun q => (num q).val)) S) ↔
        SourcesHalt (double rs (layerEquiv num))) := by
  have hplus : (fun s => 2 * s + 1) ∘ (fun q => (num q).val) =
      fun q => (layerEquiv num (q, true)).val := by
    funext q; simp [layerEquiv_val]
  have hminus : (fun s => 2 * s) ∘ (fun q => (num q).val) =
      fun q => (layerEquiv num (q, false)).val := by
    funext q; simp [layerEquiv_val]
  have hinj : Function.Injective fun q => (num q).val :=
    fun a b h => num.injective (Fin.ext h)
  refine machine_congr rfl ?_ ?_ hdet
  · simp only [doubleN, double]
    rw [← List.map_coe_finRange_eq_range, List.map_map]
    refine List.map_congr_left fun n _ => ?_
    obtain ⟨⟨q, b⟩, rfl⟩ := (layerEquiv num).surjective n
    simp only [Function.comp, Equiv.symm_apply_apply, layerEquiv_val]
    cases b <;> simp
  · intro ρ'
    rw [mem_double]
    simp only [doubleN, List.mem_append, List.mem_map, List.mem_flatMap, List.mem_range,
      or_assoc]
    refine or_congr ?_ (or_congr ?_ ?_)
    · constructor
      · rintro ⟨_, ⟨ρ, hρ, rfl⟩, rfl⟩
        exact ⟨ρ, hρ, by rw [toRule_mapQ', hplus]⟩
      · rintro ⟨ρ, hρ, rfl⟩
        exact ⟨_, ⟨ρ, hρ, rfl⟩, by rw [toRule_mapQ', hplus]⟩
    · constructor
      · rintro ⟨_, ⟨ρ, hρ, rfl⟩, rfl⟩
        exact ⟨ρ, hρ, by rw [Quad.inv_mapQ', toRule_mapQ', hminus]⟩
      · rintro ⟨ρ, hρ, rfl⟩
        exact ⟨_, ⟨ρ, hρ, rfl⟩, by rw [Quad.inv_mapQ', toRule_mapQ', hminus]⟩
    · constructor
      · rintro ⟨s, hs, h⟩
        refine ⟨num.symm ⟨s, hs⟩, ?_⟩
        have := turnRules_mapQ' hinj rs (fun s => 2 * s + 1) (fun s => 2 * s) (num.symm ⟨s, hs⟩)
        simp only [Equiv.apply_symm_apply] at this
        rw [this, hplus, hminus] at h
        exact h
      · rintro ⟨q, h⟩
        refine ⟨(num q).val, (num q).isLt, ?_⟩
        rw [turnRules_mapQ' hinj, hplus, hminus]
        exact h

end DoubleN

/-! ## 3. Computability on `ℕ`-quadruples -/

section Primcodable

/-- A quadruple on `ℕ` as `(src, op, dst)`. -/
def quadEquiv : Quad ℕ (Fin 2) ≃ ℕ × Op (Fin 2) × ℕ where
  toFun ρ := (ρ.src, ρ.op, ρ.dst)
  invFun x := ⟨x.1, x.2.1, x.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

noncomputable instance : Primcodable (Op (Fin 2)) :=
  Primcodable.ofEquiv _ (Fintype.equivFin _)

noncomputable instance : Primcodable (Quad ℕ (Fin 2)) :=
  Primcodable.ofEquiv _ quadEquiv

section PrimQuad

open RcwaSameOrbit (Test Move)

variable {α : Type*} [Primcodable α]

theorem pr_quad {ρ : α → Quad ℕ (Fin 2)} (h : Primrec ρ) : Primrec fun a => quadEquiv (ρ a) :=
  (Primrec.of_equiv (e := quadEquiv)).comp h

theorem pr_qsrc {ρ : α → Quad ℕ (Fin 2)} (h : Primrec ρ) : Primrec fun a => (ρ a).src :=
  Primrec.fst.comp (pr_quad h)

theorem pr_qop {ρ : α → Quad ℕ (Fin 2)} (h : Primrec ρ) : Primrec fun a => (ρ a).op :=
  Primrec.fst.comp (Primrec.snd.comp (pr_quad h))

theorem pr_qdst {ρ : α → Quad ℕ (Fin 2)} (h : Primrec ρ) : Primrec fun a => (ρ a).dst :=
  Primrec.snd.comp (Primrec.snd.comp (pr_quad h))

theorem pr_mkQuad {s d : α → ℕ} {o : α → Op (Fin 2)} (hs : Primrec s) (ho : Primrec o)
    (hd : Primrec d) : Primrec fun a => (⟨s a, o a, d a⟩ : Quad ℕ (Fin 2)) :=
  (Primrec.of_equiv_symm (e := quadEquiv)).comp (hs.pair (ho.pair hd))

theorem pr_mapQ {ρ : α → Quad ℕ (Fin 2)} {f : α → ℕ → ℕ} (h : Primrec ρ) (hf : Primrec₂ f) :
    Primrec fun a => (ρ a).mapQ (f a) :=
  pr_mkQuad (hf.comp Primrec.id (pr_qsrc h)) (pr_qop h) (hf.comp Primrec.id (pr_qdst h))

theorem pr_qinv {ρ : α → Quad ℕ (Fin 2)} (h : Primrec ρ) : Primrec fun a => (ρ a).inv :=
  pr_mkQuad (pr_qdst h) ((Primrec.dom_finite Op.inv).comp (pr_qop h)) (pr_qsrc h)

theorem pr_mkRule {s d : α → ℕ} {t₁ t₂ : α → Test} {d₁ d₂ : α → Move} (hs : Primrec s)
    (ht₁ : Primrec t₁) (ht₂ : Primrec t₂) (hd₁ : Primrec d₁) (hd₂ : Primrec d₂)
    (hd : Primrec d) :
    Primrec fun a => (⟨s a, t₁ a, t₂ a, d₁ a, d₂ a, d a⟩ : Rule) :=
  (Primrec.of_equiv_symm (e := RcwaSameOrbit.Rule.equivProd)).comp
    (hs.pair (ht₁.pair (ht₂.pair (hd₁.pair (hd₂.pair hd)))))

theorem toRule_eq (n : ℕ → ℕ) (ρ : Quad ℕ (Fin 2)) : toRule n ρ =
    ⟨n ρ.src, (toRule id ⟨0, ρ.op, 0⟩).t₁, (toRule id ⟨0, ρ.op, 0⟩).t₂,
      (toRule id ⟨0, ρ.op, 0⟩).d₁, (toRule id ⟨0, ρ.op, 0⟩).d₂, n ρ.dst⟩ := by
  obtain ⟨s, o, d⟩ := ρ
  cases o <;> rfl

theorem pr_toRule {ρ : α → Quad ℕ (Fin 2)} {n : α → ℕ → ℕ} (h : Primrec ρ) (hn : Primrec₂ n) :
    Primrec fun a => toRule (n a) (ρ a) := by
  have ho := pr_qop h
  refine (pr_mkRule (hn.comp Primrec.id (pr_qsrc h))
    ((Primrec.dom_finite fun o : Op (Fin 2) => (toRule id ⟨0, o, 0⟩).t₁).comp ho)
    ((Primrec.dom_finite fun o : Op (Fin 2) => (toRule id ⟨0, o, 0⟩).t₂).comp ho)
    ((Primrec.dom_finite fun o : Op (Fin 2) => (toRule id ⟨0, o, 0⟩).d₁).comp ho)
    ((Primrec.dom_finite fun o : Op (Fin 2) => (toRule id ⟨0, o, 0⟩).d₂).comp ho)
    (hn.comp Primrec.id (pr_qdst h))).of_eq fun a => (toRule_eq _ _).symm

/-- `any` with a parameter. -/
theorem list_any' {β : Type*} [Primcodable β] {f : α → List β} {p : α → β → Bool}
    (hf : Primrec f) (hp : Primrec₂ p) : Primrec fun a => (f a).any (p a) := by
  refine (Primrec.list_foldr hf (Primrec.const false)
    (Primrec.cond (hp.comp Primrec.fst (Primrec.fst.comp Primrec.snd))
      (Primrec.const true) (Primrec.snd.comp Primrec.snd)).to₂).of_eq fun a => ?_
  dsimp only
  induction f a with
  | nil => rfl
  | cons b l ih => rw [List.foldr_cons, ih, List.any_cons]; cases p a b <;> rfl

theorem pr_turnRules {rs : α → List (Quad ℕ (Fin 2))} {q : α → ℕ} (hrs : Primrec rs)
    (hq : Primrec q) :
    Primrec fun a => turnRules (rs a) (fun s => 2 * s + 1) (fun s => 2 * s) (q a) := by
  have hrs' := hrs.comp (Primrec.fst (α := α) (β := Bool × Bool))
  have hq' := hq.comp (Primrec.fst (α := α) (β := Bool × Bool))
  have hbb := Primrec.snd (α := α) (β := Bool × Bool)
  have hany : Primrec fun x : α × (Bool × Bool) => (rs x.1).any fun ρ =>
      decide (ρ.src = q x.1) && opFiresPat ρ.op x.2.1 x.2.2 := by
    refine list_any' hrs' (Primrec.and.comp
      (Primrec.eq.comp (pr_qsrc Primrec.snd) (hq'.comp Primrec.fst)).decide
      ((Primrec.dom_finite fun y : Op (Fin 2) × Bool × Bool => opFiresPat y.1 y.2.1 y.2.2).comp
        ((pr_qop Primrec.snd).pair ((Primrec.fst.comp (hbb.comp Primrec.fst)).pair
          (Primrec.snd.comp (hbb.comp Primrec.fst)))))).to₂
  have hr : Primrec fun x : α × (Bool × Bool) =>
      (⟨2 * q x.1 + 1, testOf x.2.1, testOf x.2.2, .zero, .zero, 2 * q x.1⟩ : Rule) :=
    pr_mkRule (Primrec.succ.comp (Primrec.nat_mul.comp (Primrec.const 2) hq'))
      ((Primrec.dom_finite testOf).comp (Primrec.fst.comp hbb))
      ((Primrec.dom_finite testOf).comp (Primrec.snd.comp hbb))
      (Primrec.const _) (Primrec.const _) (Primrec.nat_mul.comp (Primrec.const 2) hq')
  refine (Primrec.listFilterMap (Primrec.const [(false, false), (false, true), (true, false),
    (true, true)]) (Primrec.cond hany (Primrec.const none)
      (Primrec.option_some.comp hr)).to₂).of_eq fun a => ?_
  unfold turnRules
  refine List.filterMap_congr fun bb _ => ?_
  dsimp only
  split_ifs with h <;> simp [h]

/-- **`doubleN` is computable.** -/
theorem primrec_doubleN : Primrec₂ doubleN := by
  have hrs := Primrec.fst (α := List (Quad ℕ (Fin 2))) (β := ℕ)
  have hS := Primrec.snd (α := List (Quad ℕ (Fin 2))) (β := ℕ)
  have hK := Primrec.nat_mul.comp hS (Primrec.const 2)
  have h1 : Primrec fun x : List (Quad ℕ (Fin 2)) × ℕ =>
      x.1.map (toRule fun s => 2 * s + 1) :=
    Primrec.list_map hrs (pr_toRule Primrec.snd
      (Primrec.succ.comp (Primrec.nat_mul.comp (Primrec.const 2) Primrec.snd)).to₂).to₂
  have h2 : Primrec fun x : List (Quad ℕ (Fin 2)) × ℕ =>
      x.1.map (fun ρ => toRule (fun s => 2 * s) ρ.inv) :=
    Primrec.list_map hrs (pr_toRule (pr_qinv Primrec.snd)
      (Primrec.nat_mul.comp (Primrec.const 2) Primrec.snd).to₂).to₂
  have h3 : Primrec fun x : List (Quad ℕ (Fin 2)) × ℕ =>
      (List.range x.2).flatMap (turnRules x.1 (fun s => 2 * s + 1) (fun s => 2 * s)) :=
    Primrec.list_flatMap (Primrec.list_range.comp hS)
      (pr_turnRules (hrs.comp Primrec.fst) Primrec.snd).to₂
  have hp : Primrec fun x : List (Quad ℕ (Fin 2)) × ℕ =>
      (List.range (x.2 * 2)).map fun n => if n % 2 = 0 then n + 1 else n - 1 :=
    Primrec.list_map (Primrec.list_range.comp hK)
      (Primrec.ite (Primrec.eq.comp (Primrec.nat_mod.comp Primrec.snd (Primrec.const 2))
        (Primrec.const 0)) (Primrec.succ.comp Primrec.snd)
        (Primrec.nat_sub.comp Primrec.snd (Primrec.const 1))).to₂
  exact ((Primrec.of_equiv_symm (e := RcwaSameOrbit.Machine.equivProd)).comp
    (hK.pair ((Primrec.list_append.comp (Primrec.list_append.comp h1 h2) h3).pair hp))).of_eq
    fun x => rfl

end PrimQuad

/-- Relabelling a quadruple by a computable map is computable. -/
theorem computable_mapQ {α : Type*} [Primcodable α] {f : α → ℕ → ℕ} (hf : Computable₂ f) :
    Computable₂ fun (a : α) (ρ : Quad ℕ (Fin 2)) => ρ.mapQ (f a) := by
  have hq := (Primrec.of_equiv (e := quadEquiv)).to_comp.comp
    (Computable.snd (α := α) (β := Quad ℕ (Fin 2)))
  have hsrc := Computable.fst.comp hq
  have hop := Computable.fst.comp (Computable.snd.comp hq)
  have hdst := Computable.snd.comp (Computable.snd.comp hq)
  exact ((Primrec.of_equiv_symm (e := quadEquiv)).to_comp.comp
    ((hf.comp Computable.fst hsrc).pair (hop.pair (hf.comp Computable.fst hdst)))).of_eq
    fun x => rfl

/-- **`doubleN` is computable.** -/
theorem computable_doubleN : Computable₂ doubleN :=
  primrec_doubleN.to_comp

end Primcodable

/-! ## 4. The glued compile, numbered -/

section Compile

variable {QB ι : Type} [Fintype QB] [DecidableEq QB] (N : ℕ)

/-- The one-rule machine `some () → none` incrementing `i`: the shape of every chain link. -/
def unitRule (i : ι) : Quad (Option Unit) ι :=
  ⟨some (), .inc i, none⟩

/-- The link `hole → first` as a relabelling of `unitRule`. -/
def plugMap (hole back : QB) (L : ℕ) : Option Unit → QB ⊕ Fin L :=
  fun o => o.elim (chainFirst back L) fun _ => .inl hole

/-- The link `k → next k` as a relabelling of `unitRule`. -/
def linkMap (back : QB) {L : ℕ} (k : Fin L) : Option Unit → QB ⊕ Fin L :=
  fun o => o.elim (chainNext back k) fun _ => .inr k

/-- The numbering of the tags `GState Unit N`. -/
noncomputable def tagNum : GState Unit N ≃ Fin (Fintype.card (GState Unit N)) :=
  Fintype.equivFin _

/-- The fixed numbering of `GState QB N`. -/
noncomputable def fixNum : GState QB N ≃ Fin (Fintype.card (GState QB N)) :=
  Fintype.equivFin _

/-- **The glued numbering.**  `inl` states by `fixNum`; chain state `k`, tag `t` at
`card (GState QB N) + (tagNum t + T · k)`, `T = card (GState Unit N)`. -/
noncomputable def glueNum (L : ℕ) :
    GState (QB ⊕ Fin L) N ≃
      Fin (Fintype.card (GState QB N) + L * Fintype.card (GState Unit N)) :=
  GState.baseTagEquiv.trans ((Equiv.sumProdDistrib QB (Fin L) (GState Unit N)).trans
    ((Equiv.sumCongr (GState.baseTagEquiv.symm.trans (fixNum N))
      ((Equiv.prodCongr (Equiv.refl _) (tagNum N)).trans finProdFinEquiv)).trans
        finSumFinEquiv))

/-- The local numbering of the unit's states: tags over `some ()` first, then over `none`. -/
noncomputable def lnum (g : GState (Option Unit) N) : ℕ :=
  match g.base with
  | some _ => (tagNum N g.tag).val
  | none => Fintype.card (GState Unit N) + (tagNum N g.tag).val

/-- The table `j ↦` number of the tag `j` over the fixed state `q` (`0` off the tags). -/
noncomputable def fixTab (q : QB) (j : ℕ) : ℕ :=
  ((List.finRange (Fintype.card (GState Unit N))).map fun t =>
    (fixNum N (((tagNum N).symm t).map fun _ => q)).val).getD j 0

/-- Where unit state `n` of link `k` lands (`L` chain states). -/
noncomputable def reloc (back : QB) (L k n : ℕ) : ℕ :=
  if n < Fintype.card (GState Unit N) then
    Fintype.card (GState QB N) + (n + Fintype.card (GState Unit N) * k)
  else if k + 1 < L then
    Fintype.card (GState QB N) +
      ((n - Fintype.card (GState Unit N)) + Fintype.card (GState Unit N) * (k + 1))
  else fixTab N back (n - Fintype.card (GState Unit N))

/-- Where unit state `n` of the link `hole → first` lands. -/
noncomputable def plugReloc (hole back : QB) (L n : ℕ) : ℕ :=
  if n < Fintype.card (GState Unit N) then fixTab N hole n
  else if 0 < L then Fintype.card (GState QB N) + (n - Fintype.card (GState Unit N))
  else fixTab N back (n - Fintype.card (GState Unit N))

open Classical in
/-- The rules of `godel B₀`, as a list. -/
noncomputable def fixList (B₀ : CM QB ι) (p : ι → ℕ) : List (Quad (GState QB N) (Fin 2)) :=
  (Finset.univ.filter (· ∈ godel B₀ p N)).toList

open Classical in
/-- The rules of `godel` of the one-rule machine, as a list. -/
noncomputable def unitList (i : ι) (p : ι → ℕ) : List (Quad (GState (Option Unit) N) (Fin 2)) :=
  (Finset.univ.filter (· ∈ godel ({unitRule i} : CM (Option Unit) ι) p N)).toList

/-- **The typed rule list** of `godel (glue B₀ hole back i L)`. -/
noncomputable def rsGlue (B₀ : CM QB ι) (hole back : QB) (i : ι) (p : ι → ℕ) (L : ℕ) :
    List (Quad (GState (QB ⊕ Fin L) N) (Fin 2)) :=
  (fixList N B₀ p).map (Quad.mapQ (GState.map Sum.inl)) ++
    (unitList N i p).map (Quad.mapQ (GState.map (plugMap hole back L))) ++
      (List.finRange L).flatMap fun k =>
        (unitList N i p).map (Quad.mapQ (GState.map (linkMap back k)))

/-- **The explicit rule list** on `ℕ`: two constant lists and `L` relocated copies of `unitR`. -/
noncomputable def explicitR (B₀ : CM QB ι) (hole back : QB) (i : ι) (p : ι → ℕ) (L : ℕ) :
    List (Quad ℕ (Fin 2)) :=
  (fixList N B₀ p).map (Quad.mapQ fun g => (fixNum N g).val) ++
    ((unitList N i p).map (Quad.mapQ (lnum N))).map (Quad.mapQ (plugReloc N hole back L)) ++
      (List.range L).flatMap fun k =>
        ((unitList N i p).map (Quad.mapQ (lnum N))).map (Quad.mapQ (reloc N back L k))

omit [DecidableEq QB] in
theorem mem_fixList {B₀ : CM QB ι} {p : ι → ℕ} {r : Quad (GState QB N) (Fin 2)} :
    r ∈ fixList N B₀ p ↔ r ∈ godel B₀ p N := by
  classical
  simp [fixList]

theorem mem_unitList {i : ι} {p : ι → ℕ} {r : Quad (GState (Option Unit) N) (Fin 2)} :
    r ∈ unitList N i p ↔ r ∈ godel ({unitRule i} : CM (Option Unit) ι) p N := by
  classical
  simp [unitList]

/-- **The typed list lists `godel` of the glued machine.** -/
theorem mem_rsGlue (B₀ : CM QB ι) (hole back : QB) (i : ι) (p : ι → ℕ) (L : ℕ)
    (ρ : Quad (GState (QB ⊕ Fin L) N) (Fin 2)) :
    ρ ∈ rsGlue N B₀ hole back i p L ↔ ρ ∈ godel (glue B₀ hole back i L) p N := by
  simp only [rsGlue, List.mem_append, List.mem_map, List.mem_flatMap, List.mem_finRange,
    true_and, mem_fixList, mem_unitList]
  have hguard : ∀ q : QB ⊕ Fin L, ((∃ a, a ∈ godel B₀ p N ∧
      a.mapQ (GState.map Sum.inl) = guardRule q) ∨
      ∃ a, a ∈ godel ({unitRule i} : CM (Option Unit) ι) p N ∧
        a.mapQ (GState.map (plugMap hole back L)) = guardRule q) ∨
      ∃ k, ∃ a, a ∈ godel ({unitRule i} : CM (Option Unit) ι) p N ∧
        a.mapQ (GState.map (linkMap back k)) = guardRule q := by
    rintro (h | k)
    · exact Or.inl (Or.inl ⟨guardRule h, GRule.guard h, rfl⟩)
    · exact Or.inr ⟨k, guardRule (some ()), GRule.guard _, rfl⟩
  constructor
  · rintro ((⟨g, hg, rfl⟩ | ⟨g, hg, rfl⟩) | ⟨k, g, hg, rfl⟩)
    · exact godel_mono Set.subset_union_left (godel_mapQ Sum.inl hg)
    · refine godel_mono ?_ (godel_mapQ (plugMap hole back L) hg)
      rintro _ ⟨β, hβ, rfl⟩
      rw [Set.mem_singleton_iff] at hβ
      subst hβ
      exact Or.inr (Or.inl rfl)
    · refine godel_mono ?_ (godel_mapQ (linkMap back k) hg)
      rintro _ ⟨β, hβ, rfl⟩
      rw [Set.mem_singleton_iff] at hβ
      subst hβ
      exact Or.inr (Or.inr ⟨k, rfl⟩)
  · intro hρ
    rcases godel_local hρ with ⟨q, rfl⟩ | ⟨β, hβ, hρ'⟩
    · exact hguard q
    rcases hβ with ⟨β₀, hβ₀, rfl⟩ | (rfl | ⟨k, rfl⟩)
    · rcases godel_single_mapQ Sum.inl hρ' with ⟨q, rfl⟩ | ⟨r₀, hr₀, rfl⟩
      · exact hguard q
      · exact Or.inl (Or.inl ⟨r₀, godel_mono (Set.singleton_subset_iff.2 hβ₀) hr₀, rfl⟩)
    · rcases godel_single_mapQ (β := unitRule i) (plugMap hole back L) hρ' with
        ⟨q, rfl⟩ | ⟨r₀, hr₀, rfl⟩
      · exact hguard q
      · exact Or.inl (Or.inr ⟨r₀, hr₀, rfl⟩)
    · rcases godel_single_mapQ (β := unitRule i) (linkMap back k) hρ' with
        ⟨q, rfl⟩ | ⟨r₀, hr₀, rfl⟩
      · exact hguard q
      · exact Or.inr ⟨k, r₀, hr₀, rfl⟩

theorem GState.map_map' {X Y Z : Type*} (f : X → Y) (h : Y → Z) (g : GState X N) :
    (g.map f).map h = g.map (h ∘ f) := by cases g <;> rfl

theorem GState.base_map' {X Y : Type*} (f : X → Y) (g : GState X N) :
    (g.map f).base = f g.base := by cases g <;> rfl

theorem GState.tag_map' {X Y : Type*} (f : X → Y) (g : GState X N) :
    (g.map f).tag = g.tag := by cases g <;> rfl

theorem GState.tag_base' {X : Type*} (g : GState X N) : g.tag.map (fun _ => g.base) = g := by
  cases g <;> rfl

theorem Quad.mapQ_mapQ' {X Y Z ι' : Type*} (f : X → Y) (h : Y → Z) (ρ : Quad X ι') :
    (ρ.mapQ f).mapQ h = ρ.mapQ (h ∘ f) := rfl

omit [DecidableEq QB] in
theorem glueNum_val {L : ℕ} (g : GState (QB ⊕ Fin L) N) :
    (glueNum N L g).val = Sum.elim (fun b => (fixNum N (g.tag.map fun _ => b)).val)
      (fun k => Fintype.card (GState QB N) + ((tagNum N g.tag).val +
        Fintype.card (GState Unit N) * k.val)) g.base := by
  rcases h : g.base with b | k <;>
    simp [glueNum, GState.baseTagEquiv, h, finProdFinEquiv, finSumFinEquiv]

omit [DecidableEq QB] in
theorem fixTab_lt (q : QB) {j : ℕ} (hj : j < Fintype.card (GState Unit N)) :
    fixTab N q j = (fixNum N (((tagNum N).symm ⟨j, hj⟩).map fun _ => q)).val := by
  simp [fixTab, List.getD_eq_getElem?_getD, hj]

omit [DecidableEq QB] in
theorem glueNum_inl {L : ℕ} (g : GState QB N) :
    (glueNum N L (g.map Sum.inl)).val = (fixNum N g).val := by
  rw [glueNum_val, GState.base_map', GState.tag_map']
  simp [GState.tag_base']

omit [DecidableEq QB] in
theorem glueNum_plug (hole back : QB) {L : ℕ} (g : GState (Option Unit) N) :
    (glueNum N L (g.map (plugMap hole back L))).val = plugReloc N hole back L (lnum N g) := by
  rw [glueNum_val, GState.base_map', GState.tag_map']
  have hT := (tagNum N g.tag).isLt
  rcases h : g.base with _ | ⟨⟨⟩⟩
  · have hn : ¬ (Fintype.card (GState Unit N) + (tagNum N g.tag).val <
        Fintype.card (GState Unit N)) := by omega
    simp only [plugMap, Option.elim, lnum, h, plugReloc, chainFirst, hn, if_false,
      Nat.add_sub_cancel_left]
    split_ifs with h1
    · simp
    · simp only [Sum.elim_inl]
      rw [fixTab_lt N back hT]
      simp
  · simp only [plugMap, Option.elim, lnum, h, plugReloc, hT, if_true, Sum.elim_inl]
    rw [fixTab_lt N hole hT]
    simp

omit [DecidableEq QB] in
theorem glueNum_link (back : QB) {L : ℕ} (k : Fin L) (g : GState (Option Unit) N) :
    (glueNum N L (g.map (linkMap back k))).val = reloc N back L k.val (lnum N g) := by
  rw [glueNum_val, GState.base_map', GState.tag_map']
  have hT := (tagNum N g.tag).isLt
  rcases h : g.base with _ | ⟨⟨⟩⟩
  · have hn : ¬ (Fintype.card (GState Unit N) + (tagNum N g.tag).val <
        Fintype.card (GState Unit N)) := by omega
    simp only [linkMap, Option.elim, lnum, h, reloc, chainNext, hn, if_false,
      Nat.add_sub_cancel_left]
    split_ifs with h1
    · simp
    · simp only [Sum.elim_inl]
      rw [fixTab_lt N back hT]
      simp
  · simp only [linkMap, Option.elim, lnum, h, reloc, hT, if_true, Sum.elim_inr]

/-- **Numbering the typed list gives the explicit list.** -/
theorem rsGlue_num (B₀ : CM QB ι) (hole back : QB) (i : ι) (p : ι → ℕ) (L : ℕ) :
    (rsGlue N B₀ hole back i p L).map (Quad.mapQ fun g => (glueNum N L g).val) =
      explicitR N B₀ hole back i p L := by
  simp only [rsGlue, explicitR, List.map_append, List.map_map, List.map_flatMap]
  rw [← List.map_coe_finRange_eq_range, List.flatMap_map]
  congr 1
  congr 1
  · refine List.map_congr_left fun ρ _ => ?_
    simp only [Function.comp, Quad.mapQ, glueNum_inl]
  · refine List.map_congr_left fun ρ _ => ?_
    simp only [Function.comp, Quad.mapQ, glueNum_plug]
  · refine List.flatMap_congr fun k _ => List.map_congr_left fun ρ _ => ?_
    simp only [Function.comp, Quad.mapQ, glueNum_link]

omit [DecidableEq QB] in
theorem primrec_fixTab (q : QB) : Primrec (fixTab N q) :=
  ((Primrec.list_getD 0).comp (Primrec.const _) Primrec.id).of_eq fun _ => rfl

omit [DecidableEq QB] in
theorem primrec_plugReloc (hole back : QB) : Primrec₂ (plugReloc N hole back) := by
  have hL := Primrec.fst (α := ℕ) (β := ℕ)
  have hn := Primrec.snd (α := ℕ) (β := ℕ)
  have hm := Primrec.nat_sub.comp hn (Primrec.const (Fintype.card (GState Unit N)))
  exact (Primrec.ite (Primrec.nat_lt.comp hn (Primrec.const _))
    ((primrec_fixTab N hole).comp hn)
    (Primrec.ite (Primrec.nat_lt.comp (Primrec.const 0) hL)
      (Primrec.nat_add.comp (Primrec.const _) hm)
      ((primrec_fixTab N back).comp hm))).of_eq fun _ => rfl

omit [DecidableEq QB] in
theorem primrec_reloc (back : QB) :
    Primrec₂ fun (x : ℕ × ℕ) (n : ℕ) => reloc N back x.1 x.2 n := by
  have hL := Primrec.fst.comp (Primrec.fst (α := ℕ × ℕ) (β := ℕ))
  have hk := Primrec.snd.comp (Primrec.fst (α := ℕ × ℕ) (β := ℕ))
  have hn := Primrec.snd (α := ℕ × ℕ) (β := ℕ)
  have hT := Primrec.const (α := (ℕ × ℕ) × ℕ) (Fintype.card (GState Unit N))
  have hF := Primrec.const (α := (ℕ × ℕ) × ℕ) (Fintype.card (GState QB N))
  have hm := Primrec.nat_sub.comp hn hT
  exact (Primrec.ite (Primrec.nat_lt.comp hn hT)
    (Primrec.nat_add.comp hF (Primrec.nat_add.comp hn (Primrec.nat_mul.comp hT hk)))
    (Primrec.ite (Primrec.nat_lt.comp (Primrec.succ.comp hk) hL)
      (Primrec.nat_add.comp hF (Primrec.nat_add.comp hm
        (Primrec.nat_mul.comp hT (Primrec.succ.comp hk))))
      ((primrec_fixTab N back).comp hm))).of_eq fun _ => rfl

/-- **The explicit list is computable in `L`.** -/
theorem computable_explicitR (B₀ : CM QB ι) (hole back : QB) (i : ι) (p : ι → ℕ) :
    Computable (explicitR N B₀ hole back i p) := by
  have h2 : Primrec fun L : ℕ =>
      ((unitList N i p).map (Quad.mapQ (lnum N))).map (Quad.mapQ (plugReloc N hole back L)) :=
    Primrec.list_map (Primrec.const _) (pr_mapQ Primrec.snd
      ((primrec_plugReloc N hole back).comp (Primrec.fst.comp Primrec.fst) Primrec.snd).to₂).to₂
  have h3 : Primrec fun L : ℕ => (List.range L).flatMap fun k =>
      ((unitList N i p).map (Quad.mapQ (lnum N))).map (Quad.mapQ (reloc N back L k)) :=
    Primrec.list_flatMap Primrec.list_range
      (Primrec.list_map (Primrec.const _) (pr_mapQ Primrec.snd
        ((primrec_reloc N back).comp (Primrec.fst.comp Primrec.fst) Primrec.snd).to₂).to₂).to₂
  exact (Primrec.list_append.comp (Primrec.list_append.comp (Primrec.const _) h2) h3).to_comp

/-- **The computable compile.**  For a fixed `B₀` and gluing data there is a computable family
`G` of machines with `G L` valid and all its sources halting iff `godel (glue B₀ …  L)` is mortal,
whenever that machine is deterministic and reversible with a mortal reverse. -/
theorem exists_computable_compile (B₀ : CM QB ι) (hole back : QB) (i : ι) (p : ι → ℕ) :
    ∃ G : ℕ → Machine, Computable G ∧ ∀ L,
      (godel (glue B₀ hole back i L) p N).Det → (godel (glue B₀ hole back i L) p N).Rev →
        (godel (glue B₀ hole back i L) p N).RevMortal →
          (G L).Valid ∧ (SourcesHalt (G L) ↔ Mortal (godel (glue B₀ hole back i L) p N)) := by
  have hS : Computable fun L : ℕ =>
      Fintype.card (GState QB N) + L * Fintype.card (GState Unit N) :=
    Primrec.nat_add.to_comp.comp (Computable.const _)
      (Primrec.nat_mul.to_comp.comp Computable.id (Computable.const _))
  refine ⟨fun L => doubleN (explicitR N B₀ hole back i p L)
      (Fintype.card (GState QB N) + L * Fintype.card (GState Unit N)),
    computable_doubleN.comp (computable_explicitR N B₀ hole back i p) hS,
    fun L hd hr hm => ?_⟩
  have hrs := mem_rsGlue N B₀ hole back i p L
  have key := doubleN_valid_iff (glueNum N L) (rsGlue N B₀ hole back i p L)
    (double_deterministic _ hrs hd hr)
  rw [rsGlue_num] at key
  exact ⟨key.1.2 (double_valid _ hrs hd hr hm),
    key.2.trans (RcwaOrbitCount.double_sourcesHalt_iff _ hrs hd hr hm)⟩

end Compile

end CollatzMoonshot.RcwaTotality
