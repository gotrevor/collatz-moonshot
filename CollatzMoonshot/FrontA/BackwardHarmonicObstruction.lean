/-- The uniform supersolution weight, depending only on `(floor, r mod 19683)`.
There are `13122` unit residues modulo `19683` per floor, five floors. -/
def harmonicPotential (i : Fin 5) (r : ℕ) : ℕ :=
  (harmonicWeights[i.1 * 13122 + harmonicUnitIndex (r % 19683)]?).getD 0

theorem harmonicPotential_mod (i : Fin 5) (x : ℕ) :
    harmonicPotential i (x % 19683) = harmonicPotential i x := by
  unfold harmonicPotential
  rw [Nat.mod_mod_of_dvd x dvd_rfl]

/-! ## The shared next ternary digit (source mod 3^10, child mod 3^9) -/

/-- The child residue modulo `19683 = 3^9` determined by the source modulo
`59049 = 3^10`, including the fixed carry digit of the division `(2^j r - 1)/3`. -/
def harmonicChildResidue (r j : ℕ) : ℕ :=
  ((2 ^ j * (r % 59049) - 1) / 3) % 19683

/-- Every actual odd inverse block lands in the residue class predicted by
`harmonicChildResidue`.  Holds for arbitrary `x`, hence at every depth. -/
theorem oddBlockChild_mod_19683 {x y j : ℕ}
    (h : 3 * y + 1 = 2 ^ j * x) :
    y % 19683 = harmonicChildResidue x j := by
  unfold harmonicChildResidue
  have hx : x % 59049 + 59049 * (x / 59049) = x := Nat.mod_add_div x 59049
  have hp : 0 < 2 ^ j := pow_pos (by omega) _
  have heq :
      3 * y + 1 =
        2 ^ j * (x % 59049) + 59049 * (2 ^ j * (x / 59049)) := by
    calc
      3 * y + 1 = 2 ^ j * x := h
      _ = 2 ^ j * (x % 59049 + 59049 * (x / 59049)) :=
        congrArg (fun z => 2 ^ j * z) hx.symm
      _ = 2 ^ j * (x % 59049) + 59049 * (2 ^ j * (x / 59049)) := by ring
  have hr : 0 < x % 59049 := by
    by_contra hz
    have hz' : x % 59049 = 0 := Nat.eq_zero_of_not_pos hz
    rw [hz', mul_zero, zero_add] at heq
    omega
  have hpr : 0 < 2 ^ j * (x % 59049) := Nat.mul_pos hp hr
  let z := 2 ^ j * (x / 59049)
  have hzle : 19683 * z ≤ y := by dsimp [z]; omega
  have hnum : 2 ^ j * (x % 59049) - 1 = 3 * (y - 19683 * z) := by dsimp [z]; omega
  have ha : (2 ^ j * (x % 59049) - 1) / 3 = y - 19683 * z := by rw [hnum]; omega
  rw [ha]; omega

theorem harmonicChildResidue_mod_left (x j : ℕ) :
    harmonicChildResidue (x % 59049) j = harmonicChildResidue x j := by
  unfold harmonicChildResidue
  rw [Nat.mod_mod_of_dvd x dvd_rfl]

/-! ## The native-checked integer supersolution certificate

Harmonic edge weight `3 / 2^j` cleared to scale `2^23` (`cost_max = 23`): one
growing edge contributes `3 * 2^(23-j) * W(child)`, the safe shrinking edge
`3 * 2^22 * W(child)`. -/

/-- One integer-scaled growing harmonic edge at cost `j`. -/
def harmonicNatEdge (i : Fin 5) (r j : ℕ) : ℕ :=
  3 * 2 ^ (23 - j) *
    harmonicPotential (nextThreeQuartersState i j) (harmonicChildResidue r j)

/-- The integer-scaled harmonic image: seven growing edges plus the safe
shrinking edge when present. -/
def harmonicNatImage (i : Fin 5) (r : ℕ) : ℕ :=
  harmonicNatEdge i r (sevenCostsAt r 0) +
  harmonicNatEdge i r (sevenCostsAt r 1) +
  harmonicNatEdge i r (sevenCostsAt r 2) +
  harmonicNatEdge i r (sevenCostsAt r 3) +
  harmonicNatEdge i r (sevenCostsAt r 4) +
  harmonicNatEdge i r (sevenCostsAt r 5) +
  harmonicNatEdge i r (sevenCostsAt r 6) +
  (if threeQuartersHasShrink i r then
    3 * 2 ^ 22 *
      harmonicPotential (shrinkThreeQuartersState i) (harmonicChildResidue r 1)
   else 0)

/-- **The depth-uniform harmonic supersolution.**  For every floor `i` and every
unit source residue modulo `3^10`, the integer-scaled harmonic image is strictly
below `2^23` times the source weight.  All `5 * 39366 = 196830` cases by
`native_decide`; the exact max ratio is `0.99224... < 1`. -/
theorem harmonicNatCertificate :
    ∀ i : Fin 5, ∀ r : Fin 59049, r.1 % 3 ≠ 0 →
      harmonicNatImage i r.1 < 2 ^ 23 * harmonicPotential i r.1 := by
  native_decide

end CollatzMoonshot.FrontA
