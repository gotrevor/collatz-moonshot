theorem constrainedBlocks_length : constrainedBlocks.length = 25 := by decide +kernel

theorem partialRules_shape :
    partialRules.length = 24 ∧ ∀ r ∈ partialRules, r.length = 25 := by
  decide +kernel

theorem orphanWords_shape :
    orphanWords.length = 24 ∧
      ∀ row ∈ orphanWords,
      row.length = 9 ∧ ∀ u ∈ row,
      1 ≤ u.length ∧ u.length ≤ 5 := by
  decide +kernel

theorem constrainedBlocks_nodup : constrainedBlocks.Nodup := by decide +kernel

theorem constrainedBlocks_complement :
    ∀ a b c : Symbol, (a, b, c) ∉ constrainedBlocks ↔
      (a, b, c) = (1, 1, 2) ∨ (a, b, c) = (2, 2, 1) := by
  decide +kernel

