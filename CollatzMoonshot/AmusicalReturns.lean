import CollatzMoonshot.Obstructions.Amusical

/-!
# Returns, exits and residues: witnesses for the closed amusical routes

Statements from the 2026-10-13 research agents (reports in `RESEARCH-2026-10-13-amusical-
single-chain.md` §7), each proved on paper there.  Treadmill target
(`KICKOFF-2026-10-13-amusical-returns.md`): close every `sorry` in this file.

* `exists_large_nonOrbitMin`: every residue class mod `2^k 3^l` contains arbitrarily large
  non-minima, so no congruence certifies an orbit minimum (the provable half of
  `MinimaNotResidueDetermined`).
* `exits_eq_strictMinima`: the points of `[1, X]` that never come back are exactly as many as the
  strict orbit minima in `[1, X]` (true for any such bijection, so not a lever by itself).
* `exists_denseLinearReturns_of_finitelyManyOrbits`: the strongest form of the linear-recurrence
  reduction.
* `return_defect_bound`: at a return the linear form `n log 2 − j log 3 + log(y/x)` is only
  `O(log j)`, not small, which is why Baker-type bounds give nothing.
-/

namespace CollatzMoonshot.Amusical

open CollatzMoonshot.Obstructions.Amusical

theorem amusicalInv_pos {x : ℤ} (hx : 0 < x) : 0 < amusicalInv x := by
  unfold amusicalInv
  split_ifs <;> omega

theorem amusical_pos {x : ℤ} (hx : 0 < x) : 0 < amusical x := by
  unfold amusical
  split_ifs <;> omega

theorem amusicalPerm_zpow_pos (j : ℤ) {x : ℤ} (hx : 0 < x) :
    0 < (amusicalPerm ^ j) x := by
  revert x
  induction j using Int.induction_on with
  | zero => intro x hx; simpa
  | succ j ih =>
      intro x hx
      rw [zpow_add_one, Equiv.Perm.mul_apply]
      exact ih (amusical_pos hx)
  | pred j ih =>
      intro x hx
      rw [zpow_sub_one, Equiv.Perm.mul_apply]
      exact ih (amusicalInv_pos hx)

theorem amusicalPerm_zpow_apply_injective (x : ℤ) :
    (Function.Injective fun j : ℤ => (amusicalPerm ^ j) x) ↔
      ∀ j : ℤ, j ≠ 0 → (amusicalPerm ^ j) x ≠ x := by
  constructor
  · intro hinj j hj heq
    apply hj
    apply hinj
    simpa using heq
  · intro h i j hij
    by_contra hne
    have hfix : (amusicalPerm ^ (i - j)) x = x := by
      apply (amusicalPerm ^ j).injective
      rw [← Equiv.Perm.mul_apply, ← zpow_add, show j + (i - j) = i by omega]
      dsimp only at hij
      rw [hij]
    exact h (i - j) (sub_ne_zero.mpr hne) hfix

theorem amusicalPerm_zpow_eq_self_neg {j x : ℤ}
    (h : (amusicalPerm ^ j) x = x) : (amusicalPerm ^ (-j)) x = x := by
  apply (amusicalPerm ^ j).injective
  rw [← Equiv.Perm.mul_apply, ← zpow_add]
  simp [h]

/-- The concrete two-sided orbit is the group-action orbit of the cyclic subgroup generated by
`amusicalPerm`. -/
theorem amusicalOrbit_eq_zpowersOrbit (x : ℤ) :
    amusicalOrbit x = MulAction.orbit (Subgroup.zpowers amusicalPerm) x := by
  ext y
  constructor
  · rintro ⟨j, rfl⟩
    rw [MulAction.mem_orbit_iff]
    refine ⟨⟨amusicalPerm ^ j, Subgroup.mem_zpowers_iff.mpr ⟨j, rfl⟩⟩, ?_⟩
    rfl
  · rw [MulAction.mem_orbit_iff]
    rintro ⟨⟨g, hg⟩, rfl⟩
    obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.mp hg
    exact ⟨j, rfl⟩

/-- The integer parametrization of an infinite orbit has no repetitions. -/
theorem amusicalPerm_zpow_apply_injective_of_infinite {x : ℤ}
    (hinf : (amusicalOrbit x).Infinite) :
    Function.Injective fun j : ℤ => (amusicalPerm ^ j) x := by
  rw [amusicalPerm_zpow_apply_injective]
  intro j hj hfix
  have hfix' : (amusicalPerm ^ (-j)) x = x := amusicalPerm_zpow_eq_self_neg hfix
  let p := j.natAbs
  have hp : 0 < p := Int.natAbs_pos.mpr hj
  have hper : Function.IsPeriodicPt amusical p x := by
    change (⇑amusicalPerm)^[p] x = x
    rw [← Equiv.Perm.coe_pow]
    change (amusicalPerm ^ (p : ℤ)) x = x
    rcases lt_or_gt_of_ne hj.symm with hjpos | hjneg
    · simpa only [p, Int.natCast_natAbs, abs_of_pos hjpos] using hfix
    · simpa only [p, Int.natCast_natAbs, abs_of_neg hjneg] using hfix'
  have hmp : 0 < Function.minimalPeriod amusical x := hper.minimalPeriod_pos hp
  have hmp' : 0 < Function.minimalPeriod (fun y : ℤ => amusicalPerm • y) x := by
    change 0 < Function.minimalPeriod amusical x
    exact hmp
  letI : NeZero (Function.minimalPeriod (fun y : ℤ => amusicalPerm • y) x) := ⟨hmp'.ne'⟩
  have hfinite : (MulAction.orbit (Subgroup.zpowers amusicalPerm) x).Finite := by
    rw [← Set.finite_coe_iff]
    exact (MulAction.orbitZPowersEquiv amusicalPerm x).finite_iff.mpr inferInstance
  exact hinf (amusicalOrbit_eq_zpowersOrbit x ▸ hfinite)

/-- The forward iterates along an infinite orbit have no repetitions. -/
theorem amusical_iterate_injective_of_infinite {x : ℤ}
    (hinf : (amusicalOrbit x).Infinite) :
    Function.Injective fun i : ℕ => amusical^[i] x := by
  have hinj := amusicalPerm_zpow_apply_injective_of_infinite hinf
  intro a b hab
  change (⇑amusicalPerm)^[a] x = (⇑amusicalPerm)^[b] x at hab
  have hab' : (amusicalPerm ^ (a : ℤ)) x = (amusicalPerm ^ (b : ℤ)) x := by
    simpa only [zpow_natCast, Equiv.Perm.coe_pow] using hab
  exact_mod_cast hinj hab'

/-- Starting from at least `2`, no forward iterate can be `1`; hence all remain at least `2`. -/
theorem amusical_iterate_ge_two {x : ℤ} (hx : 2 ≤ x) (i : ℕ) : 2 ≤ amusical^[i] x := by
  have hpos : 0 < amusical^[i] x := by
    induction i with
    | zero => simpa using hx.trans_lt' (by omega)
    | succ i ih => rw [Function.iterate_succ_apply']; exact amusical_pos ih
  have hone : amusical^[i] (1 : ℤ) = 1 := by
    have hfix : Function.IsFixedPt amusical (1 : ℤ) := by
      exact amusical_small_cycles.2.1
    exact hfix.iterate i
  have hne : amusical^[i] x ≠ 1 := by
    intro h
    have hi := amusical_injective.iterate i
    exact (by omega : x ≠ 1) (hi (h.trans hone.symm))
  omega

theorem exit_has_injective_orbit {X n : ℕ} (hnX : n ≤ X)
    (hexit : ∀ j : ℕ, 0 < j → (X : ℤ) < (amusicalPerm ^ (j : ℤ)) n) :
    Function.Injective fun j : ℤ => (amusicalPerm ^ j) (n : ℤ) := by
  rw [amusicalPerm_zpow_apply_injective]
  intro j hj hfix
  rcases lt_or_gt_of_ne hj.symm with hjpos | hjneg
  · have hjnat : ((j.toNat : ℕ) : ℤ) = j := Int.toNat_of_nonneg hjpos.le
    have hknat : 0 < j.toNat := by omega
    have := hexit j.toNat hknat
    rw [hjnat, hfix] at this
    exact (not_lt_of_ge (by exact_mod_cast hnX)) this
  · have hjnat : (((-j).toNat : ℕ) : ℤ) = -j :=
      Int.toNat_of_nonneg (neg_nonneg.mpr hjneg.le)
    have hknat : 0 < (-j).toNat := by omega
    have hfix' := amusicalPerm_zpow_eq_self_neg hfix
    have := hexit (-j).toNat hknat
    rw [hjnat, hfix'] at this
    exact (not_lt_of_ge (by exact_mod_cast hnX)) this

theorem strictMin_has_injective_orbit {m : ℤ}
    (hmin : ∀ j : ℤ, j ≠ 0 → m < (amusicalPerm ^ j) m) :
    Function.Injective fun j : ℤ => (amusicalPerm ^ j) m := by
  rw [amusicalPerm_zpow_apply_injective]
  intro j hj hfix
  exact (hmin j hj).ne hfix.symm

theorem finite_forward_visits_below {m X : ℕ}
    (hmin : ∀ j : ℤ, j ≠ 0 → (m : ℤ) < (amusicalPerm ^ j) m) :
    {j : ℕ | (amusicalPerm ^ (j : ℤ)) (m : ℤ) ≤ X}.Finite := by
  let f : ℕ → ℤ := fun j => (amusicalPerm ^ (j : ℤ)) (m : ℤ)
  have himage : (f '' {j : ℕ | (amusicalPerm ^ (j : ℤ)) (m : ℤ) ≤ X}).Finite :=
    (Set.finite_Icc (m : ℤ) (X : ℤ)).subset (by
      intro y hy
      obtain ⟨j, hj, hy⟩ := hy
      rw [← hy]
      refine ⟨?_, hj⟩
      by_cases hj0 : j = 0
      · subst j; simp [f]
      · exact (hmin j (by exact_mod_cast hj0)).le)
  apply Set.Finite.of_finite_image himage
  intro a _ b _ hab
  have hinj := strictMin_has_injective_orbit hmin
  have hz : (a : ℤ) = b := hinj (by simpa [f] using hab)
  exact_mod_cast hz

/-- Injectivity of the integer parametrization of an orbit transfers to every point on that
orbit. -/
theorem amusicalPerm_zpow_apply_injective_of_mem {x y : ℤ}
    (hinj : Function.Injective fun j : ℤ => (amusicalPerm ^ j) x)
    (hy : y ∈ amusicalOrbit x) :
    Function.Injective fun j : ℤ => (amusicalPerm ^ j) y := by
  obtain ⟨r, rfl⟩ := hy
  intro i j hij
  have hir : (amusicalPerm ^ (i + r)) x = (amusicalPerm ^ (j + r)) x := by
    simpa only [zpow_add, Equiv.Perm.mul_apply] using hij
  have := hinj hir
  omega

/-- `orbitMinNat` is below every nonnegative member of the same orbit. -/
theorem orbitMinNat_le_of_nonneg_mem {x y : ℤ} (hy0 : 0 ≤ y)
    (hy : y ∈ amusicalOrbit x) : (orbitMinNat x : ℤ) ≤ y := by
  classical
  have hex : ∃ k : ℕ, (k : ℤ) ∈ amusicalOrbit x :=
    ⟨y.toNat, by rwa [Int.toNat_of_nonneg hy0]⟩
  have hymem : ((y.toNat : ℕ) : ℤ) ∈ amusicalOrbit x := by
    rwa [Int.toNat_of_nonneg hy0]
  have hle : Nat.find hex ≤ y.toNat := Nat.find_min' hex hymem
  unfold orbitMinNat minNatOf
  rw [dif_pos hex]
  rw [← Int.toNat_of_nonneg hy0]
  exact_mod_cast hle

/-- On an aperiodic positive orbit, its least natural member is a strict two-sided minimum. -/
theorem orbitMinNat_strict_of_injective {x : ℤ} (hx : 0 < x)
    (hinj : Function.Injective fun j : ℤ => (amusicalPerm ^ j) x) :
    ∀ j : ℤ, j ≠ 0 →
      (orbitMinNat x : ℤ) < (amusicalPerm ^ j) (orbitMinNat x : ℤ) := by
  have hmem := orbitMinNat_mem hx.le
  have hmpos : 0 < (orbitMinNat x : ℤ) := by
    obtain ⟨r, hr⟩ := hmem
    rw [← hr]
    exact amusicalPerm_zpow_pos r hx
  have hmorbit : amusicalOrbit (orbitMinNat x : ℤ) = amusicalOrbit x :=
    amusicalOrbit_eq_of_mem hmem
  have hminj := amusicalPerm_zpow_apply_injective_of_mem hinj hmem
  intro j hj
  have hypos : 0 < (amusicalPerm ^ j) (orbitMinNat x : ℤ) :=
    amusicalPerm_zpow_pos j hmpos
  have hymem : (amusicalPerm ^ j) (orbitMinNat x : ℤ) ∈ amusicalOrbit x := by
    rw [← hmorbit]
    exact ⟨j, rfl⟩
  have hle := orbitMinNat_le_of_nonneg_mem hypos.le hymem
  have hne : (amusicalPerm ^ j) (orbitMinNat x : ℤ) ≠ (orbitMinNat x : ℤ) := by
    intro heq
    apply hj
    apply hminj
    simpa using heq
  exact lt_of_le_of_ne hle hne.symm

/-- A strict two-sided minimum is exactly the least natural member selected from its orbit. -/
theorem orbitMinNat_eq_of_strictMin {m : ℕ}
    (hmin : ∀ j : ℤ, j ≠ 0 → (m : ℤ) < (amusicalPerm ^ j) m) :
    orbitMinNat (m : ℤ) = m := by
  have hmem := orbitMinNat_mem (show (0 : ℤ) ≤ m by positivity)
  have hle : orbitMinNat (m : ℤ) ≤ m := by
    exact_mod_cast orbitMinNat_le_of_nonneg_mem (show (0 : ℤ) ≤ m by positivity)
      (mem_amusicalOrbit_self (m : ℤ))
  have hge : m ≤ orbitMinNat (m : ℤ) := by
    obtain ⟨r, hr⟩ := hmem
    by_cases hr0 : r = 0
    · subst r
      simpa using hr.le
    · have := (hmin r hr0).le
      have hgeZ : (m : ℤ) ≤ (orbitMinNat (m : ℤ) : ℤ) := this.trans_eq hr
      exact_mod_cast hgeZ
  omega

/-- For `K = 2k + 1`, the contraction of `K` consecutive odd steps dominates any possible
expansion in the preceding `k` inverse steps. -/
theorem contracting_suffix_coefficient (k : ℕ) :
    3 ^ k * 3 ^ (2 * k + 1) + 3 ^ k ≤ 2 ^ k * 4 ^ (2 * k + 1) := by
  have h27 : 27 ^ k ≤ 32 ^ k := Nat.pow_le_pow_left (by omega) k
  have h3 : 3 ^ k ≤ 32 ^ k := Nat.pow_le_pow_left (by omega) k
  have hA : 3 ^ k * 3 ^ (2 * k + 1) = 3 * 27 ^ k := by
    rw [pow_add, pow_one, pow_mul]
    calc
      3 ^ k * ((3 ^ 2) ^ k * 3) = 3 * (3 ^ k * (3 ^ 2) ^ k) := by ring
      _ = 3 * (3 * 3 ^ 2) ^ k := by rw [mul_pow]
      _ = 3 * 27 ^ k := by norm_num
  have hB : 2 ^ k * 4 ^ (2 * k + 1) = 4 * 32 ^ k := by
    rw [pow_add, pow_one, pow_mul]
    calc
      2 ^ k * ((4 ^ 2) ^ k * 4) = 4 * (2 ^ k * (4 ^ 2) ^ k) := by ring
      _ = 4 * (2 * 4 ^ 2) ^ k := by rw [mul_pow]
      _ = 4 * 32 ^ k := by norm_num
  rw [hA, hB]
  omega

/-- A residue `1 mod 4^K` forces `K` consecutive `4m+1 ↦ 3m+1` steps. -/
theorem amusical_iterate_four_pow_mul_add_one (K : ℕ) (t : ℤ) :
    amusical^[K] ((4 : ℤ) ^ K * t + 1) = (3 : ℤ) ^ K * t + 1 := by
  induction K generalizing t with
  | zero => simp
  | succ K ih =>
      rw [Function.iterate_succ_apply]
      rw [pow_succ']
      rw [show 4 * 4 ^ K * t + 1 = 4 * (4 ^ K * t) + 1 by ring]
      rw [amusical_four_mul_add_one]
      rw [show 3 * (4 ^ K * t) + 1 = 4 ^ K * (3 * t) + 1 by ring, ih]
      rw [pow_succ']
      ring

/-- One inverse step from a nonnegative integer is at least multiplication by `2/3`. -/
theorem two_mul_le_three_mul_amusicalInv {z : ℤ} (hz : 0 ≤ z) :
    2 * z ≤ 3 * amusicalInv z := by
  unfold amusicalInv
  split_ifs <;> omega

/-- Iterating the previous lower bound: `3^k U⁻ᵏ(z) ≥ 2^k z`. -/
theorem pow_two_mul_le_pow_three_mul_amusicalInv_iterate {z : ℤ} (hz : 0 ≤ z) (k : ℕ) :
    (2 : ℤ) ^ k * z ≤ 3 ^ k * amusicalInv^[k] z := by
  induction k generalizing z with
  | zero => simp
  | succ k ih =>
      have hstep := two_mul_le_three_mul_amusicalInv hz
      have hz' : 0 ≤ amusicalInv z := amusicalInv_nonneg hz
      have hih := ih hz'
      rw [Function.iterate_succ_apply]
      rw [pow_succ', pow_succ']
      calc
        2 * 2 ^ k * z = 2 ^ k * (2 * z) := by ring
        _ ≤ 2 ^ k * (3 * amusicalInv z) :=
          mul_le_mul_of_nonneg_left hstep (by positivity)
        _ = 3 * (2 ^ k * amusicalInv z) := by ring
        _ ≤ 3 * (3 ^ k * amusicalInv^[k] (amusicalInv z)) := by omega
        _ = 3 * 3 ^ k * amusicalInv^[k] (amusicalInv z) := by ring

/-- **Target.**  Every residue class mod `2^k 3^l` has arbitrarily large non-minima.  Paper
proof: by CRT choose `n` in the class whose 2-adic digits after the forced prefix make the next
`K` steps all of type `4m+1 ↦ 3m+1`, which contracts toward `1`; for `K` large compared with the
prefix length the orbit drops below `n`. -/
theorem exists_large_nonOrbitMin (k l c T : ℕ) :
    ∃ n : ℕ, T < n ∧ n ≡ c [MOD 2 ^ k * 3 ^ l] ∧ ¬ IsOrbitMin (n : ℤ) := by
  let K : ℕ := 2 * k + 1
  have ha0 : 0 ≤ amusical^[k] (c : ℤ) := by
    induction k with
    | zero => simp
    | succ k ih => rw [Function.iterate_succ_apply']; exact amusical_nonneg ih
  let a : ℕ := (amusical^[k] (c : ℤ)).toNat
  have hacast : (a : ℤ) = amusical^[k] (c : ℤ) := Int.toNat_of_nonneg ha0
  let A : ℕ := 3 ^ (k + l)
  let B : ℕ := 4 ^ K
  have hcop : Nat.Coprime A B := by
    dsimp [A, B]
    exact Nat.Coprime.pow _ _ (by norm_num)
  let r : ℕ := (Nat.chineseRemainder hcop a 1).val
  have hrA : r ≡ a [MOD A] := (Nat.chineseRemainder hcop a 1).property.1
  have hrB : r ≡ 1 [MOD B] := (Nat.chineseRemainder hcop a 1).property.2
  let Q : ℕ := A * B
  let q : ℕ := 3 ^ k * (T + 1) + a + 2
  let m : ℕ := r + Q * q
  have hApos : 0 < A := by dsimp [A]; positivity
  have hBpos : 0 < B := by dsimp [B]; positivity
  have hQpos : 0 < Q := by dsimp [Q]; positivity
  have hmA : m ≡ a [MOD A] := by
    have hdiv : A ∣ Q * q := by
      apply dvd_mul_of_dvd_left
      exact ⟨B, by dsimp [Q]⟩
    have hzero : Q * q ≡ 0 [MOD A] := Nat.modEq_zero_iff_dvd.mpr hdiv
    simpa only [m, Nat.add_zero] using hrA.add hzero
  have hmB : m ≡ 1 [MOD B] := by
    have hdiv : B ∣ Q * q := by
      apply dvd_mul_of_dvd_left
      exact ⟨A, by dsimp [Q]; ring⟩
    have hzero : Q * q ≡ 0 [MOD B] := Nat.modEq_zero_iff_dvd.mpr hdiv
    simpa only [m, Nat.add_zero] using hrB.add hzero
  have hqle : q ≤ m := by
    have : q ≤ Q * q := Nat.le_mul_of_pos_left q hQpos
    dsimp [m]
    omega
  have hale : a ≤ m := by
    have : a ≤ q := by dsimp [q]; omega
    exact this.trans hqle
  obtain ⟨s, hms⟩ := (Nat.modEq_iff_exists_eq_add hale).mp hmA.symm
  have honele : 1 ≤ m := by
    have : 2 ≤ q := by dsimp [q]; omega
    omega
  obtain ⟨t, hmt⟩ := (Nat.modEq_iff_exists_eq_add honele).mp hmB.symm
  have htpos : 0 < t := by
    have : 2 ≤ m := by
      have : 2 ≤ q := by dsimp [q]; omega
      omega
    by_contra h
    have : t = 0 := by omega
    subst t
    simp at hmt
    omega
  dsimp [A] at hms
  dsimp [B] at hmt
  let f : ℕ := amusicalBackwardFourCount k (a : ℤ)
  let n : ℕ := c + 3 ^ l * 2 ^ (k + f) * s
  have hbase : amusicalInv^[k] (a : ℤ) = (c : ℤ) := by
    rw [hacast]
    have hleft : Function.LeftInverse amusicalInv amusical := amusicalInv_amusical
    exact hleft.iterate k (c : ℤ)
  have hniter : amusicalInv^[k] (m : ℤ) = (n : ℤ) := by
    have hmsZ : (m : ℤ) = (a : ℤ) + 3 ^ (k + l) * (s : ℤ) := by exact_mod_cast hms
    rw [hmsZ]
    rw [amusicalInv_iterate_add_pow_three_mul_slope (k + l) k (by omega)]
    rw [Nat.add_sub_cancel_left]
    rw [hbase]
    dsimp [n, f]
  have hnforward : amusical^[k] (n : ℤ) = (m : ℤ) := by
    rw [← hniter]
    have hleft : Function.LeftInverse amusical amusicalInv := amusical_amusicalInv
    exact hleft.iterate k (m : ℤ)
  have hncong : n ≡ c [MOD 2 ^ k * 3 ^ l] := by
    have hnform : n = (2 ^ k * 3 ^ l) * (2 ^ f * s) + c := by
      dsimp [n]
      rw [pow_add]
      ring
    rw [hnform]
    exact Nat.ModEq.modulus_mul_add
  have hscaleZ : (2 : ℤ) ^ k * (m : ℤ) ≤ 3 ^ k * (n : ℤ) := by
    have h := pow_two_mul_le_pow_three_mul_amusicalInv_iterate
      (show (0 : ℤ) ≤ m by positivity) k
    rwa [hniter] at h
  have hscale : 2 ^ k * m ≤ 3 ^ k * n := by exact_mod_cast hscaleZ
  have hqlarge : 3 ^ k * (T + 1) ≤ q := by dsimp [q]; omega
  have hmlarge : 3 ^ k * (T + 1) ≤ m := hqlarge.trans hqle
  have hTscale : 3 ^ k * T < 2 ^ k * m := by
    calc
      3 ^ k * T < 3 ^ k * (T + 1) := by
        exact mul_lt_mul_of_pos_left (by omega) (by positivity)
      _ ≤ m := hmlarge
      _ ≤ 2 ^ k * m := Nat.le_mul_of_pos_left m (by positivity)
  have hTn : T < n := by
    apply Nat.lt_of_mul_lt_mul_left (a := 3 ^ k)
    exact hTscale.trans_le hscale
  have hcoef : 3 ^ k * 3 ^ K + 3 ^ k ≤ 2 ^ k * 4 ^ K := by
    simpa only [K] using contracting_suffix_coefficient k
  have hsmallscale : 3 ^ k * (3 ^ K * t + 1) < 2 ^ k * (4 ^ K * t + 1) := by
    calc
      3 ^ k * (3 ^ K * t + 1) =
          (3 ^ k * 3 ^ K) * t + 3 ^ k := by ring
      _ ≤ (3 ^ k * 3 ^ K + 3 ^ k) * t := by
        have : 3 ^ k ≤ 3 ^ k * t := Nat.le_mul_of_pos_right _ htpos
        nlinarith
      _ ≤ (2 ^ k * 4 ^ K) * t := Nat.mul_le_mul_right t hcoef
      _ < (2 ^ k * 4 ^ K) * t + 2 ^ k :=
        Nat.lt_add_of_pos_right (by positivity)
      _ = 2 ^ k * (4 ^ K * t + 1) := by ring
  have hym : 3 ^ K * t + 1 < n := by
    have hmform : m = 4 ^ K * t + 1 := by omega
    rw [hmform] at hscale
    apply Nat.lt_of_mul_lt_mul_left (a := 3 ^ k)
    exact hsmallscale.trans_le hscale
  have hforced : amusical^[K] (m : ℤ) = ((3 ^ K * t + 1 : ℕ) : ℤ) := by
    calc
      amusical^[K] (m : ℤ) = amusical^[K] ((4 : ℤ) ^ K * (t : ℤ) + 1) := by
        congr 2
        exact_mod_cast (by omega : m = 4 ^ K * t + 1)
      _ = (3 : ℤ) ^ K * (t : ℤ) + 1 := amusical_iterate_four_pow_mul_add_one K t
      _ = ((3 ^ K * t + 1 : ℕ) : ℤ) := by push_cast; rfl
  have hreturn : amusical^[k + K] (n : ℤ) = ((3 ^ K * t + 1 : ℕ) : ℤ) := by
    rw [show k + K = K + k by omega, Function.iterate_add_apply, hnforward, hforced]
  refine ⟨n, hTn, hncong, ?_⟩
  intro hmin
  have hmem : amusical^[k + K] (n : ℤ) ∈ amusicalOrbit (n : ℤ) := by
    refine ⟨((k + K : ℕ) : ℤ), ?_⟩
    exact (amusical_iterate_eq_perm_pow (k + K) (n : ℤ)).symm
  have hle := hmin _ hmem
  rw [hreturn] at hle
  exact (not_lt_of_ge (by exact_mod_cast hle)) hym

open Classical in
/-- **Target.**  Exits equal strict minima: each infinite orbit meeting `[1, X]` has exactly one
last forward visit there and exactly one strict minimum there; cycles have neither. -/
theorem exits_eq_strictMinima (X : ℕ) :
    ((Finset.Icc 1 X).filter fun n : ℕ =>
        ∀ j : ℕ, 0 < j → (X : ℤ) < (amusicalPerm ^ (j : ℤ)) n).card =
      ((Finset.Icc 1 X).filter fun n : ℕ =>
        ∀ j : ℤ, j ≠ 0 → (n : ℤ) < (amusicalPerm ^ j) n).card := by
  let exits := (Finset.Icc 1 X).filter fun n : ℕ =>
    ∀ j : ℕ, 0 < j → (X : ℤ) < (amusicalPerm ^ (j : ℤ)) n
  let minima := (Finset.Icc 1 X).filter fun n : ℕ =>
    ∀ j : ℤ, j ≠ 0 → (n : ℤ) < (amusicalPerm ^ j) n
  change exits.card = minima.card
  refine Finset.card_bij (fun n _ => orbitMinNat (n : ℤ)) ?_ ?_ ?_
  · intro n hn
    have hn' := Finset.mem_filter.1 hn
    have hnIcc := Finset.mem_Icc.1 hn'.1
    have hnpos : 0 < (n : ℤ) := by exact_mod_cast hnIcc.1
    have hinj := exit_has_injective_orbit hnIcc.2 hn'.2
    have hmem := orbitMinNat_mem hnpos.le
    have hmpos : 0 < (orbitMinNat (n : ℤ) : ℤ) := by
      obtain ⟨r, hr⟩ := hmem
      rw [← hr]
      exact amusicalPerm_zpow_pos r hnpos
    have hmle : orbitMinNat (n : ℤ) ≤ n := by
      exact_mod_cast orbitMinNat_le_of_nonneg_mem hnpos.le (mem_amusicalOrbit_self (n : ℤ))
    apply Finset.mem_filter.2
    refine ⟨Finset.mem_Icc.2 ⟨by exact_mod_cast hmpos, hmle.trans hnIcc.2⟩, ?_⟩
    exact orbitMinNat_strict_of_injective hnpos hinj
  · intro a ha b hb hab
    have ha' := Finset.mem_filter.1 ha
    have hb' := Finset.mem_filter.1 hb
    have haIcc := Finset.mem_Icc.1 ha'.1
    have hbIcc := Finset.mem_Icc.1 hb'.1
    have hma := orbitMinNat_mem (show (0 : ℤ) ≤ a by positivity)
    have hmb := orbitMinNat_mem (show (0 : ℤ) ≤ b by positivity)
    have horbit : amusicalOrbit (a : ℤ) = amusicalOrbit (b : ℤ) := by
      rw [← amusicalOrbit_eq_of_mem hma, ← amusicalOrbit_eq_of_mem hmb, hab]
    have hbmem : (b : ℤ) ∈ amusicalOrbit (a : ℤ) := by
      rw [horbit]
      exact mem_amusicalOrbit_self (b : ℤ)
    obtain ⟨r, hr⟩ := hbmem
    change (amusicalPerm ^ r) (a : ℤ) = (b : ℤ) at hr
    by_cases hr0 : r = 0
    · subst r
      simpa using hr
    · rcases lt_or_gt_of_ne (Ne.symm hr0) with hrpos | hrneg
      · have hrnat : ((r.toNat : ℕ) : ℤ) = r := Int.toNat_of_nonneg hrpos.le
        have hfuture := ha'.2 r.toNat (by omega)
        rw [hrnat, hr] at hfuture
        exact absurd hfuture (not_lt_of_ge (by exact_mod_cast hbIcc.2))
      · have hrnat : (((-r).toNat : ℕ) : ℤ) = -r :=
          Int.toNat_of_nonneg (neg_nonneg.mpr hrneg.le)
        have hback : (amusicalPerm ^ (-r)) (b : ℤ) = a := by
          rw [← hr, ← Equiv.Perm.mul_apply, ← zpow_add]
          simp
        have hfuture := hb'.2 (-r).toNat (by omega)
        rw [hrnat, hback] at hfuture
        exact absurd hfuture (not_lt_of_ge (by exact_mod_cast haIcc.2))
  · intro m hm
    have hm' := Finset.mem_filter.1 hm
    have hmIcc := Finset.mem_Icc.1 hm'.1
    let visits : Finset ℕ :=
      (finite_forward_visits_below (m := m) (X := X) hm'.2).toFinset
    have hzero : 0 ∈ visits := by
      simp only [visits, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
      simpa using hmIcc.2
    let t : ℕ := visits.max' ⟨0, hzero⟩
    have htmem : t ∈ visits := Finset.max'_mem visits ⟨0, hzero⟩
    have htX : (amusicalPerm ^ (t : ℤ)) (m : ℤ) ≤ X := by
      simpa only [visits, Set.Finite.mem_toFinset, Set.mem_setOf_eq] using htmem
    have htpos : 0 < (amusicalPerm ^ (t : ℤ)) (m : ℤ) :=
      amusicalPerm_zpow_pos t (by exact_mod_cast hmIcc.1)
    let n : ℕ := ((amusicalPerm ^ (t : ℤ)) (m : ℤ)).toNat
    have hncast : (n : ℤ) = (amusicalPerm ^ (t : ℤ)) (m : ℤ) := by
      exact Int.toNat_of_nonneg htpos.le
    have hnmem : n ∈ exits := by
      apply Finset.mem_filter.2
      have hnpos : 1 ≤ n := by
        have : 0 < (n : ℤ) := by rw [hncast]; exact htpos
        exact_mod_cast this
      have hnX : n ≤ X := by
        have : (n : ℤ) ≤ X := by rw [hncast]; exact htX
        exact_mod_cast this
      refine ⟨Finset.mem_Icc.2 ⟨hnpos, hnX⟩, ?_⟩
      intro j hj
      by_contra hnot
      have hjX : (amusicalPerm ^ (j : ℤ)) (n : ℤ) ≤ X := by omega
      have hsumX : (amusicalPerm ^ ((t + j : ℕ) : ℤ)) (m : ℤ) ≤ X := by
        rw [Nat.cast_add, add_comm, zpow_add, Equiv.Perm.mul_apply, ← hncast]
        exact hjX
      have hsumMem : t + j ∈ visits := by
        simpa only [visits, Set.Finite.mem_toFinset, Set.mem_setOf_eq] using hsumX
      have hmax := Finset.le_max' visits (t + j) hsumMem
      omega
    refine ⟨n, hnmem, ?_⟩
    have hnorbit : amusicalOrbit (n : ℤ) = amusicalOrbit (m : ℤ) := by
      apply amusicalOrbit_eq_of_mem
      exact ⟨(t : ℤ), hncast.symm⟩
    rw [orbitMinNat_eq_of_orbit_eq hnorbit, orbitMinNat_eq_of_strictMin hm'.2]

open Classical in
/-- **Target.**  The strong form of the linear-recurrence reduction: finitely many orbits give an
infinite orbit with, for infinitely many `X`, at least `εX/2 − 1` times `j` with `|j| ≥ εX/4`
and value in `[0, X)`.  Equivalent to positive upper density of that orbit. -/
theorem exists_denseLinearReturns_of_finitelyManyOrbits (h : ¬ AmusicalInfinitelyManyOrbits) :
    ∃ x : ℤ, 0 ≤ x ∧ (amusicalOrbit x).Infinite ∧ ∃ ε : ℝ, 0 < ε ∧
      ∃ᶠ X : ℕ in Filter.atTop, ∃ S : Finset ℤ, ε * X / 2 - 1 ≤ S.card ∧
        ∀ j ∈ S, ε * X / 4 ≤ |(j : ℝ)| ∧ 0 ≤ (amusicalPerm ^ j) x ∧
          (amusicalPerm ^ j) x < X := by
  have hz : ¬ AmusicalOrbitsZeroDensity := fun hz =>
    h (amusicalInfinitelyManyOrbits_of_zeroDensity hz)
  simp only [AmusicalOrbitsZeroDensity, not_forall] at hz
  obtain ⟨x, hx0, hnt⟩ := hz
  set f : ℕ → ℝ := fun X =>
    (((Finset.range X).filter fun n : ℕ => (n : ℤ) ∈ amusicalOrbit x).card : ℝ) / X with hf
  have hf0 : ∀ X, 0 ≤ f X := fun X => by positivity
  obtain ⟨ε, hε, hfreq⟩ : ∃ ε : ℝ, 0 < ε ∧ ∃ᶠ X in Filter.atTop, ε ≤ f X := by
    by_contra hne
    push Not at hne
    apply hnt
    rw [tendsto_order]
    refine ⟨fun a ha => Filter.Eventually.of_forall fun X => lt_of_lt_of_le ha (hf0 X), ?_⟩
    intro a ha
    simpa [Filter.not_frequently, not_le] using hne a ha
  refine ⟨x, hx0, ?_, ε, hε, ?_⟩
  · intro hfin
    set N := hfin.toFinset.card
    have hbound : ∀ X,
        ((Finset.range X).filter fun n : ℕ => (n : ℤ) ∈ amusicalOrbit x).card ≤ N := by
      intro X
      refine Finset.card_le_card_of_injOn (fun n : ℕ => (n : ℤ)) ?_ ?_
      · intro n hn
        simp only [Finset.coe_filter, Set.mem_ofPred_eq] at hn
        simpa using hn.2
      · intro a _ b _ hab; simpa using hab
    have hlim : ∀ᶠ X : ℕ in Filter.atTop, f X < ε := by
      have ht : Filter.Tendsto (fun X : ℕ => (N : ℝ) / X) Filter.atTop (nhds 0) :=
        tendsto_const_div_atTop_nhds_zero_nat _
      filter_upwards [ht.eventually (gt_mem_nhds hε), Filter.eventually_ge_atTop 1] with X hX hX1
      refine lt_of_le_of_lt ?_ hX
      have hXpos : (0 : ℝ) < X := by exact_mod_cast hX1
      exact div_le_div_of_nonneg_right (by exact_mod_cast hbound X) hXpos.le
    exact (hfreq.and_eventually hlim).exists.elim fun X hX => absurd hX.1 (not_le.2 hX.2)
  · refine (hfreq.and_eventually (Filter.eventually_ge_atTop 1)).mono ?_
    rintro X ⟨hXε, hX1⟩
    have hXpos : (0 : ℝ) < X := by exact_mod_cast hX1
    set A := (Finset.range X).filter fun n : ℕ => (n : ℤ) ∈ amusicalOrbit x
    have hA : ε * X ≤ A.card := by
      have := hXε
      simp only [hf] at this
      rwa [le_div_iff₀ hXpos] at this
    let g : ℕ → ℤ := fun n =>
      if hn : (n : ℤ) ∈ amusicalOrbit x then Classical.choose hn else 0
    have hg : ∀ n ∈ A, (amusicalPerm ^ g n) x = n := by
      intro n hn
      have hn' : (n : ℤ) ∈ amusicalOrbit x := (Finset.mem_filter.1 hn).2
      simp only [g, dif_pos hn']
      exact Classical.choose_spec hn'
    have hginj : Set.InjOn g A := by
      intro a ha b hb hab
      have hab' := (hg a ha).symm.trans
        ((congrArg (fun j => (amusicalPerm ^ j) x) hab).trans (hg b hb))
      exact_mod_cast hab'
    set q : ℕ := Nat.ceil (ε * X / 4)
    have hqpos : 0 < q := by
      apply Nat.ceil_pos.2
      positivity
    set B := A.image g
    set S := B.filter fun j : ℤ => (q : ℤ) ≤ |j|
    refine ⟨S, ?_, ?_⟩
    · have hB : B.card = A.card := Finset.card_image_of_injOn hginj
      have hbad : (B.filter fun j : ℤ => ¬ (q : ℤ) ≤ |j|).card ≤ 2 * q - 1 := by
        calc
          _ ≤ (Finset.Icc (-(q : ℤ) + 1) ((q : ℤ) - 1)).card := by
            apply Finset.card_le_card
            intro z hz
            simp only [Finset.mem_filter, Finset.mem_Icc] at hz ⊢
            have hzabs : |z| < (q : ℤ) := by omega
            have hzrange := (abs_lt.mp hzabs)
            omega
          _ ≤ 2 * q - 1 := by
            rw [Int.card_Icc]
            omega
      have hsplit := Finset.card_filter_add_card_filter_not (s := B)
        (fun j : ℤ => (q : ℤ) ≤ |j|)
      have hq : (q : ℝ) < ε * X / 4 + 1 := Nat.ceil_lt_add_one (by positivity)
      have hcast : ((2 * q - 1 : ℕ) : ℝ) = 2 * (q : ℝ) - 1 := by
        rw [Nat.cast_sub (by omega : 1 ≤ 2 * q)]
        push_cast
        rfl
      have hbadR : ((B.filter fun j : ℤ => ¬ (q : ℤ) ≤ |j|).card : ℝ) ≤
          ε * X / 2 + 1 := by
        have : ((B.filter fun j : ℤ => ¬ (q : ℤ) ≤ |j|).card : ℝ) ≤
            (2 * q - 1 : ℕ) := by exact_mod_cast hbad
        rw [hcast] at this
        linarith
      have hsplitR : (S.card : ℝ) +
          ((B.filter fun j : ℤ => ¬ (q : ℤ) ≤ |j|).card : ℝ) = B.card := by
        exact_mod_cast hsplit
      have hBR : (B.card : ℝ) = A.card := by exact_mod_cast hB
      linarith
    · intro j hj
      have hj' := Finset.mem_filter.1 hj
      obtain ⟨n, hnA, rfl⟩ := Finset.mem_image.1 hj'.1
      have hqceil : ε * X / 4 ≤ (q : ℝ) := Nat.le_ceil _
      have hqabs : ((q : ℤ) : ℝ) ≤ ((|g n| : ℤ) : ℝ) := by
        exact_mod_cast hj'.2
      have hn0 : 0 ≤ (n : ℤ) := by positivity
      have hnX : (n : ℤ) < X := by
        exact_mod_cast Finset.mem_range.1 (Finset.mem_filter.1 hnA).1
      rw [hg n hnA]
      refine ⟨?_, hn0, hnX⟩
      push_cast at hqabs ⊢
      exact hqceil.trans hqabs

/-- The 2-adic weight of the first `j` steps from `x`: `1` per even step, `2` per odd step, so
`U^j x ≈ 3^j x / 2^(stepWeight x j)`. -/
def stepWeight (x : ℤ) (j : ℕ) : ℕ :=
  ∑ i ∈ Finset.range j, if amusical^[i] x % 2 = 0 then 1 else 2

/-- A single step contributes at most `1 / (3z - 1)` to the logarithmic defect. -/
theorem amusical_local_defect_bound {z : ℤ} (hz : 2 ≤ z) :
    |(((if z % 2 = 0 then 1 else 2 : ℕ) : ℝ) * Real.log 2 - Real.log 3 +
        Real.log ((amusical z : ℝ) / z))| ≤ 1 / (3 * (z : ℝ) - 1) := by
  have hzR : (2 : ℝ) ≤ z := by exact_mod_cast hz
  have hz0 : (z : ℝ) ≠ 0 := by positivity
  by_cases heven : z % 2 = 0
  · have hU : 2 * amusical z = 3 * z := by
      unfold amusical
      split_ifs <;> omega
    have hratio : (amusical z : ℝ) / z = 3 / 2 := by
      have hUR : (2 : ℝ) * amusical z = 3 * z := by exact_mod_cast hU
      field_simp
      linarith
    simp only [heven, if_pos, Nat.cast_one, one_mul, hratio]
    rw [Real.log_div (by norm_num : (3 : ℝ) ≠ 0) (by norm_num : (2 : ℝ) ≠ 0)]
    simp
    linarith
  · have hUpos : (amusical z : ℝ) ≠ 0 := by
      have : 0 < amusical z := amusical_pos (by omega)
      exact_mod_cast this.ne'
    have hlog4 : Real.log (4 : ℝ) = 2 * Real.log 2 := by
      rw [show (4 : ℝ) = 2 * 2 by norm_num,
        Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) (by norm_num : (2 : ℝ) ≠ 0)]
      ring
    by_cases hfour : z % 4 = 1
    · have hU : 4 * amusical z = 3 * z + 1 := by
        unfold amusical
        split_ifs <;> omega
      have hUreal : (amusical z : ℝ) = (3 * (z : ℝ) + 1) / 4 := by
        have hUR : (4 : ℝ) * amusical z = 3 * z + 1 := by exact_mod_cast hU
        linarith
      have hnum0 : (3 * (z : ℝ) + 1) ≠ 0 := by positivity
      have hden0 : (3 * (z : ℝ)) ≠ 0 := by positivity
      have heq :
          (2 : ℝ) * Real.log 2 - Real.log 3 + Real.log ((amusical z : ℝ) / z) =
            Real.log ((3 * (z : ℝ) + 1) / (3 * z)) := by
        rw [Real.log_div hUpos hz0, hUreal,
          Real.log_div hnum0 (by norm_num : (4 : ℝ) ≠ 0),
          Real.log_div hnum0 hden0,
          Real.log_mul (by norm_num : (3 : ℝ) ≠ 0) hz0, hlog4]
        ring
      simp only [heven, if_false, Nat.cast_ofNat]
      rw [heq]
      have hqpos : (0 : ℝ) < (3 * (z : ℝ) + 1) / (3 * z) := by positivity
      have hqone : (1 : ℝ) ≤ (3 * (z : ℝ) + 1) / (3 * z) := by
        apply (le_div_iff₀ (by positivity : (0 : ℝ) < 3 * z)).2
        linarith
      rw [abs_of_nonneg (Real.log_nonneg hqone)]
      calc
        Real.log ((3 * (z : ℝ) + 1) / (3 * z))
            ≤ (3 * (z : ℝ) + 1) / (3 * z) - 1 :=
          Real.log_le_sub_one_of_pos hqpos
        _ ≤ 1 / (3 * (z : ℝ) - 1) := by
          have h3z : (0 : ℝ) < 3 * z := by positivity
          have h3zm : (0 : ℝ) < 3 * z - 1 := by linarith
          field_simp
          nlinarith
    · have hU : 4 * amusical z = 3 * z - 1 := by
        unfold amusical
        split_ifs <;> omega
      have hUreal : (amusical z : ℝ) = (3 * (z : ℝ) - 1) / 4 := by
        have hUR : (4 : ℝ) * amusical z = 3 * z - 1 := by exact_mod_cast hU
        linarith
      have hnum0 : (3 * (z : ℝ) - 1) ≠ 0 := by linarith
      have hden0 : (3 * (z : ℝ)) ≠ 0 := by positivity
      have heq :
          (2 : ℝ) * Real.log 2 - Real.log 3 + Real.log ((amusical z : ℝ) / z) =
            Real.log ((3 * (z : ℝ) - 1) / (3 * z)) := by
        rw [Real.log_div hUpos hz0, hUreal,
          Real.log_div hnum0 (by norm_num : (4 : ℝ) ≠ 0),
          Real.log_div hnum0 hden0,
          Real.log_mul (by norm_num : (3 : ℝ) ≠ 0) hz0, hlog4]
        ring
      simp only [heven, if_false, Nat.cast_ofNat]
      rw [heq]
      have hqpos : (0 : ℝ) < (3 * (z : ℝ) - 1) / (3 * z) := by
        exact div_pos (by linarith) (by linarith)
      have hqnonneg : (0 : ℝ) ≤ (3 * (z : ℝ) - 1) / (3 * z) := hqpos.le
      have hqone : (3 * (z : ℝ) - 1) / (3 * z) ≤ (1 : ℝ) := by
        apply (div_le_one (by positivity : (0 : ℝ) < 3 * z)).2
        linarith
      rw [abs_of_nonpos (Real.log_nonpos hqnonneg hqone)]
      have hlog := Real.one_sub_inv_le_log_of_pos hqpos
      have h3z : (0 : ℝ) < 3 * z := by positivity
      have h3zm : (0 : ℝ) < 3 * z - 1 := by linarith
      calc
        -Real.log ((3 * (z : ℝ) - 1) / (3 * z))
            ≤ ((3 * (z : ℝ) - 1) / (3 * z))⁻¹ - 1 := by linarith
        _ = 1 / (3 * (z : ℝ) - 1) := by
          field_simp
          ring

/-- The return defect is the sum of its one-step defects. -/
theorem return_defect_eq_sum {x : ℤ} (hx : 2 ≤ x) (j : ℕ) :
    (stepWeight x j : ℝ) * Real.log 2 - j * Real.log 3 +
        Real.log ((amusical^[j] x : ℝ) / x) =
      ∑ i ∈ Finset.range j,
        (((if amusical^[i] x % 2 = 0 then 1 else 2 : ℕ) : ℝ) * Real.log 2 -
          Real.log 3 + Real.log ((amusical (amusical^[i] x) : ℝ) / amusical^[i] x)) := by
  induction j with
  | zero => simp [stepWeight]
  | succ j ih =>
      have hz := amusical_iterate_ge_two hx j
      have hz0 : (amusical^[j] x : ℝ) ≠ 0 := by
        exact_mod_cast (by omega : amusical^[j] x ≠ 0)
      have hUz0 : (amusical (amusical^[j] x) : ℝ) ≠ 0 := by
        exact_mod_cast (amusical_pos (by omega : 0 < amusical^[j] x)).ne'
      have hx0 : (x : ℝ) ≠ 0 := by exact_mod_cast (by omega : x ≠ 0)
      have hlog :
          Real.log ((amusical^[j + 1] x : ℝ) / x) =
            Real.log ((amusical (amusical^[j] x) : ℝ) / amusical^[j] x) +
              Real.log ((amusical^[j] x : ℝ) / x) := by
        rw [Function.iterate_succ_apply']
        rw [Real.log_div hUz0 hx0, Real.log_div hUz0 hz0, Real.log_div hz0 hx0]
        ring
      rw [Finset.sum_range_succ, stepWeight, Finset.sum_range_succ]
      change
        (((stepWeight x j : ℕ) +
              (if amusical^[j] x % 2 = 0 then 1 else 2) : ℕ) : ℝ) * Real.log 2 -
            ((j + 1 : ℕ) : ℝ) * Real.log 3 +
              Real.log ((amusical^[j + 1] x : ℝ) / x) = _
      push_cast
      rw [hlog]
      calc
        _ = ((stepWeight x j : ℝ) * Real.log 2 - j * Real.log 3 +
              Real.log ((amusical^[j] x : ℝ) / x)) +
            (((if amusical^[j] x % 2 = 0 then 1 else 2 : ℕ) : ℝ) * Real.log 2 -
              Real.log 3 +
                Real.log ((amusical (amusical^[j] x) : ℝ) / amusical^[j] x)) := by
          simp only [Nat.cast_ite, Nat.cast_one, Nat.cast_ofNat]
          ring
        _ = _ := by
          rw [ih]
          simp only [Nat.cast_ite, Nat.cast_one, Nat.cast_ofNat]

/-- Triangle inequality and the one-step estimate reduce the defect to a reciprocal sum. -/
theorem return_defect_le_reciprocal_sum {x : ℤ} (hx : 2 ≤ x) (j : ℕ) :
    |(stepWeight x j : ℝ) * Real.log 2 - j * Real.log 3 +
        Real.log ((amusical^[j] x : ℝ) / x)| ≤
      ∑ i ∈ Finset.range j, 1 / (3 * (amusical^[i] x : ℝ) - 1) := by
  rw [return_defect_eq_sum hx]
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  apply Finset.sum_le_sum
  intro i hi
  exact amusical_local_defect_bound (amusical_iterate_ge_two hx i)

open Classical in
/-- For distinct integers at least `2`, a decreasing reciprocal sum is largest on
`2, 3, ..., j + 1`. -/
theorem reciprocal_sum_le_initial {u : ℕ → ℤ} (hlo : ∀ i, 2 ≤ u i)
    (hinj : Function.Injective u) (j : ℕ) :
    (∑ i ∈ Finset.range j, 1 / (3 * (u i : ℝ) - 1)) ≤
      ∑ i ∈ Finset.range j, 1 / (3 * ((i + 2 : ℕ) : ℝ) - 1) := by
  let s : Finset ℤ := (Finset.range j).image u
  have hinjOn : Set.InjOn u (Finset.range j : Set ℕ) := hinj.injOn
  have hcard : s.card = j := by
    rw [show s = (Finset.range j).image u by rfl,
      Finset.card_image_of_injOn hinjOn, Finset.card_range]
  let e : Fin j ↪o ℤ := s.orderEmbOfFin hcard
  have he_mem : ∀ i : Fin j, e i ∈ s := by
    intro i
    have hi : e i ∈ Set.range e := ⟨i, rfl⟩
    rw [Finset.range_orderEmbOfFin s hcard] at hi
    exact hi
  have hsmin : ∀ z ∈ s, (2 : ℤ) ≤ z := by
    intro z hz
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hz
    exact hlo i
  have helower : ∀ i : Fin j, (2 : ℤ) + i.val ≤ e i := by
    rcases j with _ | j
    · intro i
      exact Fin.elim0 i
    · intro i
      induction i using Fin.induction with
      | zero => simpa using hsmin (e 0) (he_mem 0)
      | succ i ih =>
          have hlt : e i.castSucc < e i.succ := e.strictMono Fin.castSucc_lt_succ
          change (2 : ℤ) + (i.val + 1 : ℕ) ≤ e i.succ
          push_cast
          change (2 : ℤ) + i.val ≤ e i.castSucc at ih
          omega
  calc
    (∑ i ∈ Finset.range j, 1 / (3 * (u i : ℝ) - 1)) =
        ∑ z ∈ s, 1 / (3 * (z : ℝ) - 1) := by
      unfold s
      rw [Finset.sum_image hinjOn]
    _ = ∑ i : Fin j, 1 / (3 * (e i : ℝ) - 1) := by
      rw [← Finset.map_orderEmbOfFin_univ s hcard, Finset.sum_map]
      rfl
    _ ≤ ∑ i : Fin j, 1 / (3 * (((i.val + 2 : ℕ) : ℤ) : ℝ) - 1) := by
      apply Finset.sum_le_sum
      intro i hi
      apply one_div_le_one_div_of_le
      · norm_num
        have hi0 : (0 : ℝ) ≤ i.val := by positivity
        linarith
      · have hle : (((i.val + 2 : ℕ) : ℤ) : ℝ) ≤ (e i : ℝ) := by
          exact_mod_cast (by simpa [add_comm] using helower i)
        linarith
    _ = ∑ i ∈ Finset.range j, 1 / (3 * ((i + 2 : ℕ) : ℝ) - 1) := by
      simpa using (Fin.sum_univ_eq_sum_range
        (fun i : ℕ => 1 / (3 * ((i + 2 : ℕ) : ℝ) - 1)) j)

/-- The reciprocal majorant is bounded by one third of a logarithmic increment. -/
theorem initial_reciprocal_le_log (i : ℕ) :
    1 / (3 * ((i + 2 : ℕ) : ℝ) - 1) ≤
      1 / 3 * Real.log (((6 * i + 13 : ℕ) : ℝ) / (6 * i + 7)) := by
  let a : ℝ := 6 / ((6 * i + 7 : ℕ) : ℝ)
  have hden : (0 : ℝ) < ((6 * i + 7 : ℕ) : ℝ) := by positivity
  have ha : 0 ≤ a := by dsimp [a]; positivity
  have hlog := Real.le_log_one_add_of_nonneg ha
  have hratio : 1 + a = (((6 * i + 13 : ℕ) : ℝ) / (6 * i + 7)) := by
    dsimp [a]
    push_cast
    field_simp
    ring
  have heq : 1 / (3 * ((i + 2 : ℕ) : ℝ) - 1) =
      1 / 3 * (2 * a / (a + 2)) := by
    dsimp [a]
    push_cast
    field_simp
    have hi0 : (0 : ℝ) ≤ i := by positivity
    have hd : (3 : ℝ) * ((i : ℝ) + 2) - 1 ≠ 0 := by linarith
    field_simp [hd]
    ring
  rw [heq, ← hratio]
  exact mul_le_mul_of_nonneg_left hlog (by norm_num)

/-- The logarithmic increments telescope exactly. -/
theorem log_sum_telescope (j : ℕ) :
    (∑ i ∈ Finset.range j,
        1 / 3 * Real.log (((6 * i + 13 : ℕ) : ℝ) / (6 * i + 7))) =
      1 / 3 * Real.log (((6 * j + 7 : ℕ) : ℝ) / 7) := by
  induction j with
  | zero => norm_num
  | succ j ih =>
      rw [Finset.sum_range_succ, ih]
      have h7 : (7 : ℝ) ≠ 0 := by norm_num
      have hj7 : (((6 * j + 7 : ℕ) : ℝ)) ≠ 0 := by positivity
      have hj13 : (((6 * j + 13 : ℕ) : ℝ)) ≠ 0 := by positivity
      simp only [Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat, Nat.cast_one] at hj7 hj13 ⊢
      have hnext : (6 : ℝ) * (j + 1) + 7 = 6 * j + 13 := by ring
      rw [hnext]
      rw [Real.log_div hj7 h7, Real.log_div hj13 hj7, Real.log_div hj13 h7]
      ring

/-- Summing the previous pointwise estimate gives the required logarithmic majorant. -/
theorem initial_reciprocal_sum_bound (j : ℕ) :
    (∑ i ∈ Finset.range j, 1 / (3 * ((i + 2 : ℕ) : ℝ) - 1)) ≤
      1 / 3 * Real.log (((6 * j + 7 : ℕ) : ℝ) / 7) := by
  calc
    _ ≤ ∑ i ∈ Finset.range j,
        1 / 3 * Real.log (((6 * i + 13 : ℕ) : ℝ) / (6 * i + 7)) := by
      apply Finset.sum_le_sum
      intro i hi
      exact initial_reciprocal_le_log i
    _ = _ := log_sum_telescope j

/-- **Target.**  The return defect: along an aperiodic orbit from `x ≥ 2`, odd steps multiply by
`(3/4)(1 ± 1/(3z))` with distinct `z ≥ 2`, so the linear form in `log 2`, `log 3` and
`log (U^j x / x)` is at most `Σ_{z=2}^{j+1} 1/(3z−1) ≤ (1/3) log((6j+7)/7)`. -/
theorem return_defect_bound {x : ℤ} (hx : 2 ≤ x) (hinf : (amusicalOrbit x).Infinite) (j : ℕ) :
    |(stepWeight x j : ℝ) * Real.log 2 - j * Real.log 3 +
        Real.log ((amusical^[j] x : ℝ) / x)| ≤ 1 / 3 * Real.log ((6 * j + 7) / 7) := by
  have hinj := amusical_iterate_injective_of_infinite hinf
  calc
    _ ≤ ∑ i ∈ Finset.range j, 1 / (3 * (amusical^[i] x : ℝ) - 1) :=
      return_defect_le_reciprocal_sum hx j
    _ ≤ ∑ i ∈ Finset.range j, 1 / (3 * ((i + 2 : ℕ) : ℝ) - 1) :=
      reciprocal_sum_le_initial (fun i => amusical_iterate_ge_two hx i) hinj j
    _ ≤ 1 / 3 * Real.log (((6 * j + 7 : ℕ) : ℝ) / 7) :=
      initial_reciprocal_sum_bound j
    _ = _ := by push_cast; rfl

end CollatzMoonshot.Amusical
